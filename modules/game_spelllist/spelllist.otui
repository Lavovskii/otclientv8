// The Spells window, on the Task Board's and Store's pieces (data/images/taskboard, data/images/store), opened from an
// action bar slot (Assign Spell) and by the !spells command.
// Inside the window: 880 x 562. A header of 60 (the character, how many spells are ready, the next spell and how far it
// is), the tabs (kinds of spell, search, only what I can cast), then two columns 8 apart: the list (338) grouped by level,
// and the chosen spell (its card, eight facts and the demo on stone). The bottom row: drag hint, parameter, Assign, Close.

SpellFrame < UIWidget
  image-source: /images/taskboard/frame
  image-border: 3
  phantom: true

SpellBox < UIWidget
  image-source: /images/taskboard/inset
  image-border: 2
  phantom: true

SpellCaption < Label
  height: 18
  image-source: /images/taskboard/caption
  image-border: 2
  text-align: center
  color: #d8c08a
  font: verdana-11px-rounded
  phantom: true

SpellGoldButton < UIButton
  font: verdana-11px-rounded
  color: #ffeab0
  image-source: /images/store/gold_button
  image-clip: 0 0 40 30
  image-border: 4
  text-offset: 0 0
  change-cursor-image: true
  cursor: pointer

  $hover !disabled:
    image-clip: 0 30 40 30
    color: #ffffff

  $pressed:
    image-clip: 0 60 40 30
    text-offset: 1 1

  $disabled:
    image-color: #ffffff70
    color: #ffeab060
    change-cursor-image: false

SpellCategoryButton < UIButton
  size: 104 30
  image-source: /images/taskboard/tab
  image-clip: 0 0 48 34
  image-border: 4
  font: verdana-11px-rounded
  color: #a0a0a0
  margin-right: 4
  change-cursor-image: true
  cursor: pointer

  $hover !on:
    image-clip: 0 34 48 34
    color: #d4d4d4

  $on:
    image-clip: 0 68 48 34
    color: #f4d68c

SpellBar < UIWidget
  height: 14
  image-source: /images/taskboard/track
  image-border: 2
  phantom: true

  UIProgressBar
    id: bar
    anchors.fill: parent
    margin: 1
    background-color: #c8963c
    phantom: true

  UIWidget
    id: gloss
    anchors.fill: parent
    margin: 1
    image-source: /images/taskboard/gloss
    phantom: true

  Label
    id: count
    anchors.centerIn: parent
    text-auto-resize: true
    font: verdana-11px-antialised
    color: #ffffff
    phantom: true

// a level group of the list: the caption bar with the range and how many of its spells are ready
SpellGroupHeader < UIWidget
  height: 22
  focusable: false
  phantom: true

  SpellCaption
    id: caption
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.verticalCenter: parent.verticalCenter
    text-align: left
    text-offset: 8 0

  Label
    id: ready
    anchors.right: parent.right
    anchors.verticalCenter: parent.verticalCenter
    margin-right: 8
    text-auto-resize: true
    font: verdana-11px-rounded
    color: #8fd48f
    phantom: true

// one spell: its icon in a cell, name and words, level and whether it can be cast
SpellRow < UIWidget
  height: 46
  margin-top: 2
  focusable: true
  image-source: /images/store/offer
  image-border: 2
  change-cursor-image: true
  cursor: pointer

  $hover !focus:
    image-source: /images/store/offer_hover

  $focus:
    image-source: /images/store/offer_focus

  UIWidget
    id: cell
    size: 38 38
    anchors.left: parent.left
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 4
    image-source: /images/taskboard/cell
    image-border: 2
    phantom: true

  UIWidget
    id: icon
    size: 32 32
    anchors.centerIn: cell
    image-source: /images/game/spells/defaultspells
    image-clip: 0 0 32 32
    phantom: true

  UIWidget
    id: lock
    size: 16 16
    anchors.right: cell.right
    anchors.bottom: cell.bottom
    margin: 0 -2 -2 0
    image-source: /images/taskboard/lock26
    image-smooth: true
    phantom: true
    visible: false

  Label
    id: name
    anchors.left: cell.right
    anchors.right: level.left
    anchors.top: parent.top
    margin: 7 6 0 8
    height: 14
    font: verdana-11px-rounded
    color: #ececec
    phantom: true

  Label
    id: words
    anchors.left: name.left
    anchors.right: status.left
    anchors.top: name.bottom
    margin-top: 4
    margin-right: 6
    height: 14
    font: verdana-11px-rounded
    color: #c9a95a
    phantom: true

  Label
    id: level
    anchors.right: parent.right
    anchors.top: parent.top
    margin: 7 8 0 0
    text-auto-resize: true
    font: verdana-11px-rounded
    color: #b0b0b0
    phantom: true

  Label
    id: status
    anchors.right: parent.right
    anchors.top: level.bottom
    margin: 4 8 0 0
    text-auto-resize: true
    font: verdana-11px-rounded
    color: #8fd48f
    phantom: true

// one fact of the chosen spell: a small caption over the value
SpellFact < UIWidget
  height: 38
  image-source: /images/taskboard/plate
  image-border: 2
  phantom: false

  Label
    id: key
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: parent.right
    margin: 4 6 0 6
    height: 12
    text-align: center
    font: verdana-9px
    color: #a08c60
    phantom: true

  Label
    id: value
    anchors.top: key.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin: 3 4 0 4
    height: 14
    text-align: center
    font: verdana-11px-rounded
    color: #f0f0f0
    phantom: true

// a word in colour beside the spell's name (its kind, its element)
SpellChip < Label
  height: 18
  text-auto-resize: true
  padding: 0 7 0 7
  image-source: /images/taskboard/plate
  image-border: 2
  font: verdana-11px-rounded
  text-align: center
  color: #d8d8d8
  margin-left: 4
  phantom: true

// the spell under the mouse while it's dragged to an action bar
SpellDragIcon < UIWidget
  size: 32 32
  image-source: /images/game/spells/defaultspells
  image-clip: 0 0 32 32
  focusable: false
  phantom: true

SpellDemoLayer < UIWidget
  anchors.fill: parent
  phantom: true

SpellDemoFloor < UIWidget
  anchors.left: parent.left
  anchors.top: parent.top
  image-source: /images/game/floor
  image-color: #8a8a8a
  border-width: 1
  border-color: #00000030
  phantom: true

SpellDemoArea < UIWidget
  anchors.left: parent.left
  anchors.top: parent.top
  background-color: #e8b03a2a
  border-width: 1
  border-color: #e8b03a40
  phantom: true

SpellDemoCreature < UICreature
  anchors.left: parent.left
  anchors.top: parent.top
  phantom: true

SpellDemoItem < UIItem
  anchors.left: parent.left
  anchors.top: parent.top
  virtual: true
  phantom: true

SpellDemoEffect < UIWidget
  anchors.left: parent.left
  anchors.top: parent.top
  image-source: /images/game/spelldemo/effects
  image-clip: 0 0 64 64
  phantom: true

SpellDemoMissile < UIWidget
  anchors.left: parent.left
  anchors.top: parent.top
  image-source: /images/game/spelldemo/missiles
  image-clip: 0 0 32 32
  phantom: true

// the admins' editor of one spell (Add / Edit in the Spells window)
SpellEditLabel < Label
  font: verdana-11px-rounded
  color: #c9b98f
  margin-top: 7

SpellEditCheck < CheckBox
  width: 84
  height: 16

SpellEditWindow < MainWindow
  size: 390 486
  !text: tr('Spell')

  SpellEditLabel
    id: nameLabel
    !text: tr('Name')
    anchors.left: parent.left
    anchors.top: parent.top
    margin-top: 0
  TextEdit
    id: name
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.top: prev.bottom
    margin-top: 2

  SpellEditLabel
    !text: tr('Words')
    anchors.left: parent.left
    anchors.top: prev.bottom
  TextEdit
    id: words
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.top: prev.bottom
    margin-top: 2

  SpellEditLabel
    id: levelLabel
    !text: tr('Level')
    anchors.left: parent.left
    anchors.top: words.bottom
  SpellEditLabel
    id: maglevelLabel
    !text: tr('Magic level')
    anchors.left: parent.horizontalCenter
    anchors.top: levelLabel.top
    margin-left: 4
    margin-top: 0
  TextEdit
    id: level
    anchors.left: parent.left
    anchors.right: parent.horizontalCenter
    anchors.top: levelLabel.bottom
    margin-top: 2
    margin-right: 4
  TextEdit
    id: maglevel
    anchors.left: parent.horizontalCenter
    anchors.right: parent.right
    anchors.top: maglevelLabel.bottom
    margin-top: 2
    margin-left: 4

  SpellEditLabel
    id: manaLabel
    !text: tr('Mana')
    anchors.left: parent.left
    anchors.top: level.bottom
  SpellEditLabel
    id: exhaustionLabel
    !text: tr('Cooldown (ms)')
    anchors.left: parent.horizontalCenter
    anchors.top: manaLabel.top
    margin-left: 4
    margin-top: 0
  TextEdit
    id: mana
    anchors.left: parent.left
    anchors.right: parent.horizontalCenter
    anchors.top: manaLabel.bottom
    margin-top: 2
    margin-right: 4
  TextEdit
    id: exhaustion
    anchors.left: parent.horizontalCenter
    anchors.right: parent.right
    anchors.top: exhaustionLabel.bottom
    margin-top: 2
    margin-left: 4

  SpellEditLabel
    id: demoLabel
    !text: tr('Demo of (empty: this spell)')
    anchors.left: parent.left
    anchors.top: mana.bottom
  TextEdit
    id: demo
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.top: demoLabel.bottom
    margin-top: 2

  SpellEditLabel
    id: kindLabel
    !text: tr('Kind')
    anchors.left: parent.left
    anchors.top: demo.bottom
  SpellEditCheck
    id: group1
    !text: tr('Attack')
    anchors.left: parent.left
    anchors.top: kindLabel.bottom
    margin-top: 3
  SpellEditCheck
    id: group2
    !text: tr('Healing')
    anchors.left: prev.right
    anchors.top: prev.top
  SpellEditCheck
    id: group3
    !text: tr('Support')
    anchors.left: prev.right
    anchors.top: prev.top

  SpellEditLabel
    id: vocationsLabel
    !text: tr('Vocations')
    anchors.left: parent.left
    anchors.top: group1.bottom
  SpellEditCheck
    id: voc1
    !text: tr('Sorcerer')
    anchors.left: parent.left
    anchors.top: vocationsLabel.bottom
    margin-top: 3
  SpellEditCheck
    id: voc2
    !text: tr('Druid')
    anchors.left: prev.right
    anchors.top: prev.top
  SpellEditCheck
    id: voc3
    !text: tr('Paladin')
    anchors.left: prev.right
    anchors.top: prev.top
  SpellEditCheck
    id: voc4
    !text: tr('Knight')
    anchors.left: prev.right
    anchors.top: prev.top
  SpellEditCheck
    id: voc5
    !text: tr('Archmage')
    !tooltip: tr('Archmage (and SpellWarden)')
    anchors.left: parent.left
    anchors.top: voc1.bottom
    margin-top: 3
  SpellEditCheck
    id: voc6
    !text: tr('Stormbr.')
    !tooltip: tr('Stormbringer (and Lifewarden)')
    anchors.left: prev.right
    anchors.top: prev.top
  SpellEditCheck
    id: voc7
    !text: tr('Sharpsh.')
    !tooltip: tr('Sharpshooter (and Templar)')
    anchors.left: prev.right
    anchors.top: prev.top
  SpellEditCheck
    id: voc8
    !text: tr('Warlord')
    !tooltip: tr('Warlord (and Guardian)')
    anchors.left: prev.right
    anchors.top: prev.top
  SpellEditCheck
    id: premium
    !text: tr('Premium')
    anchors.left: parent.left
    anchors.top: voc5.bottom
    margin-top: 10
  SpellEditCheck
    id: needlearn
    !text: tr('Must be learned')
    width: 130
    anchors.left: prev.right
    anchors.top: prev.top

  SpellEditLabel
    id: iconLabel
    !text: tr('Icon')
    anchors.left: parent.left
    anchors.top: premium.bottom
  Button
    id: iconPrev
    text: <
    width: 22
    anchors.left: parent.left
    anchors.top: iconLabel.bottom
    margin-top: 9
  UIWidget
    id: icon
    size: 32 32
    anchors.left: prev.right
    anchors.top: iconLabel.bottom
    margin-top: 4
    margin-left: 6
    image-source: /images/game/spells/defaultspells
    image-clip: 0 0 32 32
  Button
    id: iconNext
    text: >
    width: 22
    anchors.left: prev.right
    anchors.top: iconPrev.top
    margin-left: 6
  Label
    id: iconName
    anchors.left: prev.right
    anchors.right: parent.right
    anchors.verticalCenter: icon.verticalCenter
    margin-left: 8
    font: verdana-11px-rounded
    color: #9f9f9f

  Button
    id: resetButton
    !text: tr('Built-in values')
    !tooltip: tr('Forget the changes to this spell and use the one built into the client')
    width: 100
    anchors.left: parent.left
    anchors.bottom: parent.bottom

  Button
    id: okButton
    !text: tr('Save')
    width: 70
    anchors.right: cancelButton.left
    anchors.bottom: parent.bottom
    margin-right: 6

  Button
    id: cancelButton
    !text: tr('Cancel')
    width: 70
    anchors.right: parent.right
    anchors.bottom: parent.bottom

MainWindow
  id: spelllistWindow
  !text: tr('Spells')
  size: 900 660
  @onEscape: modules.game_spelllist.toggle()

  // ------------------------------------------------------------------------------------ the character and the next spell
  SpellFrame
    id: header
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: parent.right
    height: 60

  SpellBox
    id: portrait
    size: 52 52
    anchors.left: header.left
    anchors.verticalCenter: header.verticalCenter
    margin-left: 4

    UIWidget
      id: floor
      anchors.fill: parent
      margin: 2
      image-source: /images/taskboard/stage
      image-clip: 274 91 48 48
      phantom: true

    UICreature
      id: creature
      size: 66 66
      anchors.centerIn: parent
      phantom: true

  Label
    id: vocationLabel
    anchors.left: portrait.right
    anchors.top: header.top
    margin: 9 0 0 10
    text-auto-resize: true
    font: sans-bold-16px
    color: #f4d68c

  Label
    id: summaryLabel
    anchors.left: vocationLabel.left
    anchors.top: vocationLabel.bottom
    margin-top: 5
    text-auto-resize: true
    font: verdana-11px-rounded
    color: #c4c4c4

  Label
    id: nextLabel
    anchors.right: header.right
    anchors.top: header.top
    margin: 10 12 0 0
    width: 300
    text-align: right
    font: verdana-11px-rounded
    color: #d8c08a

  SpellBar
    id: nextBar
    anchors.right: header.right
    anchors.top: nextLabel.bottom
    margin: 6 12 0 0
    width: 300

  // ------------------------------------------------------------------------------------------------------ the tabs row
  Panel
    id: categories
    anchors.top: header.bottom
    anchors.left: parent.left
    margin-top: 6
    width: 440
    height: 30
    layout:
      type: horizontalBox

  CheckBox
    id: castableOnly
    anchors.right: parent.right
    anchors.verticalCenter: categories.verticalCenter
    width: 150
    !text: tr('Only what I can cast')
    @onCheckChange: modules.game_spelllist.setCastableOnly(self:isChecked())

  TextEdit
    id: search
    anchors.right: castableOnly.left
    anchors.verticalCenter: categories.verticalCenter
    margin-right: 12
    width: 210
    placeholder: Search a spell or its words
    @onTextChange: modules.game_spelllist.setSearch(self:getText())

  // ------------------------------------------------------------------------------------------------ the bottom row
  Button
    id: closeButton
    !text: tr('Close')
    width: 80
    height: 30
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    @onClick: modules.game_spelllist.toggle()

  SpellGoldButton
    id: assignButton
    !text: tr('Assign to the slot')
    width: 150
    height: 30
    anchors.right: closeButton.left
    anchors.bottom: parent.bottom
    margin-right: 6
    @onClick: modules.game_spelllist.assignSelected()

  TextEdit
    id: paramText
    anchors.right: assignButton.left
    anchors.verticalCenter: assignButton.verticalCenter
    margin-right: 6
    width: 160
    placeholder: Parameter (a name)
    visible: false

  UIWidget
    id: dragIcon
    size: 16 16
    anchors.left: parent.left
    anchors.verticalCenter: closeButton.verticalCenter
    image-source: /images/taskboard/star16
    phantom: true

  Label
    id: dragHint
    !text: tr('Drag a spell onto an action bar.')
    anchors.left: dragIcon.right
    anchors.right: paramText.left
    anchors.verticalCenter: closeButton.verticalCenter
    margin-left: 6
    margin-right: 8
    font: verdana-11px-rounded
    color: #a08c60

  // admins only: the list is kept on the server (web API), like the Store
  Panel
    id: adminBar
    anchors.left: parent.left
    anchors.verticalCenter: closeButton.verticalCenter
    width: 338
    height: 22
    visible: false

    Button
      id: addButton
      !text: tr('Add')
      width: 50
      anchors.left: parent.left
      anchors.verticalCenter: parent.verticalCenter
      @onClick: modules.game_spelllist.adminEdit(false)

    Button
      id: editButton
      !text: tr('Edit')
      width: 50
      anchors.left: prev.right
      anchors.verticalCenter: parent.verticalCenter
      margin-left: 3
      @onClick: modules.game_spelllist.adminEdit(true)

    Button
      id: deleteButton
      !text: tr('Delete')
      width: 60
      anchors.left: prev.right
      anchors.verticalCenter: parent.verticalCenter
      margin-left: 3
      @onClick: modules.game_spelllist.adminDelete()

    CheckBox
      id: showDeleted
      !text: tr('Show deleted')
      anchors.left: prev.right
      anchors.right: parent.right
      anchors.verticalCenter: parent.verticalCenter
      margin-left: 8
      @onCheckChange: modules.game_spelllist.setShowDeleted(self:isChecked())

  // ------------------------------------------------------------------------------------------- the list, by level
  SpellFrame
    id: listFrame
    anchors.top: categories.bottom
    anchors.left: parent.left
    anchors.bottom: closeButton.top
    margin-top: 6
    margin-bottom: 8
    width: 338

  TextList
    id: spellList
    vertical-scrollbar: spellsScrollBar
    anchors.fill: listFrame
    margin: 4 16 4 4
    padding: 0
    focusable: false
    background-color: alpha
    border-width: 0

  VerticalScrollBar
    id: spellsScrollBar
    anchors.top: listFrame.top
    anchors.bottom: listFrame.bottom
    anchors.right: listFrame.right
    margin: 4 3 4 0
    step: 48
    pixels-scroll: true

  Label
    id: emptyLabel
    anchors.top: listFrame.top
    anchors.left: listFrame.left
    anchors.right: listFrame.right
    margin: 60 20 0 20
    text-align: center
    text-wrap: true
    text-auto-resize: true
    font: verdana-11px-rounded
    color: #9f9f9f
    !text: tr('No spell matches.')
    visible: false

  // ----------------------------------------------------------------------------------------------- the chosen spell
  SpellFrame
    id: details
    anchors.top: listFrame.top
    anchors.left: listFrame.right
    anchors.right: parent.right
    anchors.bottom: listFrame.bottom
    margin-left: 8

  UIWidget
    id: iconCell
    size: 44 44
    anchors.left: details.left
    anchors.top: details.top
    margin: 8 0 0 8
    image-source: /images/taskboard/cell
    image-border: 2
    phantom: true

  UIWidget
    id: icon
    size: 32 32
    anchors.centerIn: iconCell
    image-source: /images/game/spells/defaultspells
    image-clip: 0 0 32 32
    phantom: true

  Label
    id: name
    anchors.left: iconCell.right
    anchors.top: iconCell.top
    margin: 3 0 0 10
    text-auto-resize: true
    font: sans-bold-16px
    color: #ffffff

  Label
    id: words
    anchors.left: name.left
    anchors.top: name.bottom
    margin-top: 5
    text-auto-resize: true
    font: verdana-11px-rounded
    color: #e8c66a

  Panel
    id: chips
    anchors.right: details.right
    anchors.top: details.top
    margin: 12 10 0 0
    height: 18
    width: 220
    layout:
      type: horizontalBox
      align-right: true

  // the facts in a column on the right, the demo square on the left of them
  Panel
    id: facts
    anchors.top: iconCell.bottom
    anchors.right: details.right
    anchors.bottom: statusLabel.top
    margin: 8 8 6 0
    width: 150
    layout:
      type: verticalBox
      spacing: 4

  SpellBox
    id: stage
    anchors.top: iconCell.bottom
    anchors.left: details.left
    anchors.right: facts.left
    anchors.bottom: statusLabel.top
    margin: 8 8 6 8

  Panel
    id: demo
    anchors.fill: stage
    margin: 2
    clipping: true
    background-color: #101010

  Label
    id: demoHint
    anchors.centerIn: demo
    text-auto-resize: true
    font: verdana-11px-rounded
    color: #9f9f9f
    !text: tr('Click a spell to see it cast.')
    phantom: true

  UIButton
    id: replayButton
    size: 26 26
    anchors.right: demo.right
    anchors.bottom: demo.bottom
    margin: 0 6 6 0
    image-source: /images/taskboard/reroll22
    image-smooth: true
    !tooltip: tr('Play the demo again')
    change-cursor-image: true
    cursor: pointer
    opacity: 0.8
    @onClick: modules.game_spelllist.replay()

    $hover:
      opacity: 1.0

  Label
    id: statusLabel
    anchors.left: details.left
    anchors.right: details.right
    anchors.bottom: details.bottom
    margin: 0 10 8 10
    height: 14
    text-align: center
    font: verdana-11px-rounded
    color: #8fd48f

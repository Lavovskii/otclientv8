// the Spells window: the spells of the character's vocation grouped by level on the left, the chosen spell and a demo
// of what it looks like on the right

SpellCategoryButton < TabButton
  size: 62 20
  font: verdana-11px-rounded
  margin-right: 3

SpellGroupHeader < Label
  height: 18
  font: verdana-11px-rounded
  color: #e8c66a
  text-offset: 6 3
  background-color: #00000088
  border-width-bottom: 1
  border-color: #6b5a2c
  focusable: false
  phantom: true

SpellRow < UIWidget
  height: 38
  focusable: true
  background-color: alpha

  $hover !focus:
    background-color: #ffffff10

  $focus:
    background-color: #ffffff26

  UIWidget
    id: icon
    size: 32 32
    anchors.left: parent.left
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 3
    image-source: /images/game/spells/defaultspells
    image-clip: 0 0 32 32
    phantom: true

  Label
    id: name
    anchors.left: icon.right
    anchors.right: level.left
    anchors.top: parent.top
    margin-left: 7
    margin-top: 4
    font: verdana-11px-rounded
    color: #e6e6e6
    phantom: true

  Label
    id: words
    anchors.left: name.left
    anchors.right: parent.right
    anchors.top: name.bottom
    margin-top: 2
    font: verdana-11px-rounded
    color: #c9a95a
    phantom: true

  Label
    id: level
    anchors.right: parent.right
    anchors.top: parent.top
    margin-right: 5
    margin-top: 4
    text-auto-resize: true
    font: verdana-11px-rounded
    color: #9f9f9f
    phantom: true

SpellInfoRow < Panel
  height: 15
  margin-top: 1

  Label
    id: key
    anchors.left: parent.left
    anchors.top: parent.top
    width: 82
    font: verdana-11px-rounded
    color: #9f9f9f

  Label
    id: value
    anchors.left: key.right
    anchors.right: parent.right
    anchors.top: parent.top
    font: verdana-11px-rounded
    color: #e6e6e6

SpellDemoLayer < UIWidget
  anchors.fill: parent
  phantom: true

SpellDemoFloor < UIWidget
  anchors.left: parent.left
  anchors.top: parent.top
  image-source: /images/game/floor
  image-color: #8a8a8a
  border-width: 1
  border-color: #00000030
  phantom: true

SpellDemoArea < UIWidget
  anchors.left: parent.left
  anchors.top: parent.top
  background-color: #e8b03a2a
  border-width: 1
  border-color: #e8b03a40
  phantom: true

SpellDemoCreature < UICreature
  anchors.left: parent.left
  anchors.top: parent.top
  phantom: true

SpellDemoItem < UIItem
  anchors.left: parent.left
  anchors.top: parent.top
  virtual: true
  phantom: true

SpellDemoEffect < UIWidget
  anchors.left: parent.left
  anchors.top: parent.top
  image-source: /images/game/spelldemo/effects
  image-clip: 0 0 64 64
  phantom: true

SpellDemoMissile < UIWidget
  anchors.left: parent.left
  anchors.top: parent.top
  image-source: /images/game/spelldemo/missiles
  image-clip: 0 0 32 32
  phantom: true

// the admins' editor of one spell (Add / Edit in the Spells window)
SpellEditLabel < Label
  font: verdana-11px-rounded
  color: #c9b98f
  margin-top: 7

SpellEditCheck < CheckBox
  width: 84
  height: 16

SpellEditWindow < MainWindow
  size: 390 486
  !text: tr('Spell')

  SpellEditLabel
    id: nameLabel
    !text: tr('Name')
    anchors.left: parent.left
    anchors.top: parent.top
    margin-top: 0
  TextEdit
    id: name
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.top: prev.bottom
    margin-top: 2

  SpellEditLabel
    !text: tr('Words')
    anchors.left: parent.left
    anchors.top: prev.bottom
  TextEdit
    id: words
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.top: prev.bottom
    margin-top: 2

  SpellEditLabel
    id: levelLabel
    !text: tr('Level')
    anchors.left: parent.left
    anchors.top: words.bottom
  SpellEditLabel
    id: maglevelLabel
    !text: tr('Magic level')
    anchors.left: parent.horizontalCenter
    anchors.top: levelLabel.top
    margin-left: 4
    margin-top: 0
  TextEdit
    id: level
    anchors.left: parent.left
    anchors.right: parent.horizontalCenter
    anchors.top: levelLabel.bottom
    margin-top: 2
    margin-right: 4
  TextEdit
    id: maglevel
    anchors.left: parent.horizontalCenter
    anchors.right: parent.right
    anchors.top: maglevelLabel.bottom
    margin-top: 2
    margin-left: 4

  SpellEditLabel
    id: manaLabel
    !text: tr('Mana')
    anchors.left: parent.left
    anchors.top: level.bottom
  SpellEditLabel
    id: exhaustionLabel
    !text: tr('Cooldown (ms)')
    anchors.left: parent.horizontalCenter
    anchors.top: manaLabel.top
    margin-left: 4
    margin-top: 0
  TextEdit
    id: mana
    anchors.left: parent.left
    anchors.right: parent.horizontalCenter
    anchors.top: manaLabel.bottom
    margin-top: 2
    margin-right: 4
  TextEdit
    id: exhaustion
    anchors.left: parent.horizontalCenter
    anchors.right: parent.right
    anchors.top: exhaustionLabel.bottom
    margin-top: 2
    margin-left: 4

  SpellEditLabel
    id: demoLabel
    !text: tr('Demo of (empty: this spell)')
    anchors.left: parent.left
    anchors.top: mana.bottom
  TextEdit
    id: demo
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.top: demoLabel.bottom
    margin-top: 2

  SpellEditLabel
    id: kindLabel
    !text: tr('Kind')
    anchors.left: parent.left
    anchors.top: demo.bottom
  SpellEditCheck
    id: group1
    !text: tr('Attack')
    anchors.left: parent.left
    anchors.top: kindLabel.bottom
    margin-top: 3
  SpellEditCheck
    id: group2
    !text: tr('Healing')
    anchors.left: prev.right
    anchors.top: prev.top
  SpellEditCheck
    id: group3
    !text: tr('Support')
    anchors.left: prev.right
    anchors.top: prev.top

  SpellEditLabel
    id: vocationsLabel
    !text: tr('Vocations')
    anchors.left: parent.left
    anchors.top: group1.bottom
  SpellEditCheck
    id: voc1
    !text: tr('Sorcerer')
    anchors.left: parent.left
    anchors.top: vocationsLabel.bottom
    margin-top: 3
  SpellEditCheck
    id: voc2
    !text: tr('Druid')
    anchors.left: prev.right
    anchors.top: prev.top
  SpellEditCheck
    id: voc3
    !text: tr('Paladin')
    anchors.left: prev.right
    anchors.top: prev.top
  SpellEditCheck
    id: voc4
    !text: tr('Knight')
    anchors.left: prev.right
    anchors.top: prev.top
  SpellEditCheck
    id: voc5
    !text: tr('Master S.')
    !tooltip: tr('Master Sorcerer')
    anchors.left: parent.left
    anchors.top: voc1.bottom
    margin-top: 3
  SpellEditCheck
    id: voc6
    !text: tr('Elder D.')
    !tooltip: tr('Elder Druid')
    anchors.left: prev.right
    anchors.top: prev.top
  SpellEditCheck
    id: voc7
    !text: tr('Royal P.')
    !tooltip: tr('Royal Paladin')
    anchors.left: prev.right
    anchors.top: prev.top
  SpellEditCheck
    id: voc8
    !text: tr('Elite K.')
    !tooltip: tr('Elite Knight')
    anchors.left: prev.right
    anchors.top: prev.top
  SpellEditCheck
    id: premium
    !text: tr('Premium')
    anchors.left: parent.left
    anchors.top: voc5.bottom
    margin-top: 10
  SpellEditCheck
    id: needlearn
    !text: tr('Must be learned')
    width: 130
    anchors.left: prev.right
    anchors.top: prev.top

  SpellEditLabel
    id: iconLabel
    !text: tr('Icon')
    anchors.left: parent.left
    anchors.top: premium.bottom
  Button
    id: iconPrev
    text: <
    width: 22
    anchors.left: parent.left
    anchors.top: iconLabel.bottom
    margin-top: 9
  UIWidget
    id: icon
    size: 32 32
    anchors.left: prev.right
    anchors.top: iconLabel.bottom
    margin-top: 4
    margin-left: 6
    image-source: /images/game/spells/defaultspells
    image-clip: 0 0 32 32
  Button
    id: iconNext
    text: >
    width: 22
    anchors.left: prev.right
    anchors.top: iconPrev.top
    margin-left: 6
  Label
    id: iconName
    anchors.left: prev.right
    anchors.right: parent.right
    anchors.verticalCenter: icon.verticalCenter
    margin-left: 8
    font: verdana-11px-rounded
    color: #9f9f9f

  Button
    id: resetButton
    !text: tr('Built-in values')
    !tooltip: tr('Forget the changes to this spell and use the one built into the client')
    width: 100
    anchors.left: parent.left
    anchors.bottom: parent.bottom

  Button
    id: okButton
    !text: tr('Save')
    width: 70
    anchors.right: cancelButton.left
    anchors.bottom: parent.bottom
    margin-right: 6

  Button
    id: cancelButton
    !text: tr('Cancel')
    width: 70
    anchors.right: parent.right
    anchors.bottom: parent.bottom

MainWindow
  id: spelllistWindow
  !text: tr('Spells')
  size: 640 548
  @onEscape: modules.game_spelllist.toggle()

  Panel
    id: categories
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: parent.right
    height: 20
    layout:
      type: horizontalBox

  CheckBox
    id: castableOnly
    anchors.top: parent.top
    anchors.right: parent.right
    margin-top: 3
    width: 150
    !text: tr('Only what I can cast')
    @onCheckChange: modules.game_spelllist.setCastableOnly(self:isChecked())

  TextEdit
    id: search
    anchors.top: categories.bottom
    anchors.left: parent.left
    width: 268
    margin-top: 7
    placeholder: Search a spell or its words
    @onTextChange: modules.game_spelllist.setSearch(self:getText())

  Label
    id: vocationLabel
    anchors.top: search.top
    anchors.left: search.right
    anchors.right: parent.right
    margin-left: 10
    margin-top: 4
    font: verdana-11px-rounded
    color: #c9b98f

  TextList
    id: spellList
    vertical-scrollbar: spellsScrollBar
    anchors.top: search.bottom
    anchors.left: parent.left
    anchors.bottom: closeButton.top
    margin-top: 6
    margin-bottom: 8
    width: 268
    padding: 1
    padding-right: 14
    focusable: false

  VerticalScrollBar
    id: spellsScrollBar
    anchors.top: spellList.top
    anchors.bottom: spellList.bottom
    anchors.right: spellList.right
    step: 38
    pixels-scroll: true

  Label
    id: emptyLabel
    anchors.top: spellList.top
    anchors.left: spellList.left
    anchors.right: spellList.right
    margin-top: 40
    text-align: center
    text-wrap: true
    text-auto-resize: true
    font: verdana-11px-rounded
    color: #9f9f9f
    !text: tr('No spell matches.')
    visible: false

  Panel
    id: details
    anchors.top: spellList.top
    anchors.left: spellList.right
    anchors.right: parent.right
    anchors.bottom: spellList.bottom
    margin-left: 12

    UIWidget
      id: icon
      size: 32 32
      anchors.left: parent.left
      anchors.top: parent.top
      image-source: /images/game/spells/defaultspells
      image-clip: 0 0 32 32

    Label
      id: name
      anchors.left: icon.right
      anchors.right: parent.right
      anchors.top: parent.top
      margin-left: 8
      margin-top: 1
      font: verdana-11px-rounded
      color: #ffffff

    Label
      id: words
      anchors.left: name.left
      anchors.right: parent.right
      anchors.top: name.bottom
      margin-top: 3
      font: verdana-11px-rounded
      color: #e8c66a

    Panel
      id: info
      anchors.top: icon.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 6
      height: 66
      layout:
        type: verticalBox

    Panel
      id: demo
      anchors.top: info.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.bottom: parent.bottom
      margin-top: 6
      clipping: true
      background-color: #101010
      border-width: 1
      border-color: #5b4b25

    Label
      id: demoHint
      anchors.centerIn: demo
      text-auto-resize: true
      font: verdana-11px-rounded
      color: #9f9f9f
      !text: tr('Click a spell to see it cast.')

  Button
    id: replayButton
    !text: tr('Replay')
    width: 64
    anchors.left: details.left
    anchors.bottom: parent.bottom
    @onClick: modules.game_spelllist.replay()

  Button
    id: closeButton
    !text: tr('Close')
    width: 64
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    @onClick: modules.game_spelllist.toggle()

  // admins only: the list is kept on the server (web API), like the Store
  Panel
    id: adminBar
    anchors.left: parent.left
    anchors.bottom: parent.bottom
    width: 268
    height: 22
    visible: false

    Button
      id: addButton
      !text: tr('Add')
      width: 46
      anchors.left: parent.left
      anchors.verticalCenter: parent.verticalCenter
      @onClick: modules.game_spelllist.adminEdit(false)

    Button
      id: editButton
      !text: tr('Edit')
      width: 46
      anchors.left: prev.right
      anchors.verticalCenter: parent.verticalCenter
      margin-left: 3
      @onClick: modules.game_spelllist.adminEdit(true)

    Button
      id: deleteButton
      !text: tr('Delete')
      width: 56
      anchors.left: prev.right
      anchors.verticalCenter: parent.verticalCenter
      margin-left: 3
      @onClick: modules.game_spelllist.adminDelete()

    CheckBox
      id: showDeleted
      !text: tr('Show deleted')
      anchors.left: prev.right
      anchors.right: parent.right
      anchors.verticalCenter: parent.verticalCenter
      margin-left: 8
      @onCheckChange: modules.game_spelllist.setShowDeleted(self:isChecked())

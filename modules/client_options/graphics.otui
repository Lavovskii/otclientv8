OptionPanel
  Label
    text-wrap: false
    @onSetup: |
      self:setText(tr("GPU: ") .. g_graphics.getRenderer())      

  Label
    text-wrap: false
    @onSetup: |
      self:setText(tr("Version: ") .. g_graphics.getVersion())      

  HorizontalSeparator
    id: separator
    margin: 5 5 5 5

  OptionCheckBox
    id: vsync
    !text: tr('Enable vertical synchronization')
    !tooltip: tr('Limits FPS (usually to 60)')

  OptionCheckBox
    id: showFps
    !text: tr('Show frame rate')

  OptionCheckBox
    id: enableLights
    !text: tr('Enable lights')

  OptionCheckBox
    id: fullscreen
    !text: tr('Fullscreen')
    tooltip: Ctrl+Shift+F

  OptionCheckBox
    id: antialiasing
    !text: tr('Antialiasing')

  // the FPS tips are this label's tooltip since 2026-11-16: the spell effect options took their room
  Label
    margin-top: 12
    id: optimizationLevelLabel
    !text: tr("Optimization level")
    !tooltip: tr("If you have FPS issues:\n- Use OpenGL version (_gl)\n- Disable vertical synchronization\n- Set higher optimization level\n- Lower screen resolution\nOr report it on forum: http://otclient.net")

  ComboBox
    id: optimizationLevel
    margin-top: 3
    margin-right: 2
    margin-left: 2
    @onOptionChange: modules.client_options.setOption(self:getId(), self.currentIndex)
    @onSetup: |
      self:addOption("Automatic")
      self:addOption("None")
      self:addOption("Low")
      self:addOption("Medium")
      self:addOption("High")
      self:addOption("Maximum")
      
  Label
    !text: tr('High/Maximum optimization level may cause visual defects.')
    margin-top: 5

  Label
    id: backgroundFrameRateLabel
    !text: tr('Game framerate limit: %s', 'max')
    margin-top: 12
    @onSetup: |
      local value = modules.client_options.getOption('backgroundFrameRate')
      local text = value
      if value <= 0 or value >= 201 then
        text = 'max'
      end
      self:setText(tr('Game framerate limit: %s', text))

  OptionScrollbar
    id: backgroundFrameRate
    margin-top: 3
    minimum: 10
    maximum: 201

  Label
    id: ambientLightLabel
    margin-top: 6
    @onSetup: |
      local value = modules.client_options.getOption('ambientLight')
      self:setText(tr('Ambient light: %s%%', value))

  OptionScrollbar
    id: ambientLight
    margin-top: 3
    minimum: 0
    maximum: 100

  // the vocations' spells are drawn by the client (modules/game_spellfx): yours and other players' apart
  HorizontalSeparator
    margin-top: 10

  Label
    id: spellEffectsLabel
    margin-top: 6
    color: #ffd57a
    !text: tr('Spell effects')

  OptionCheckBox
    id: showOwnSpellEffects
    margin-top: 4
    !text: tr('Show my spell effects')
    !tooltip: tr('Draw the effects of the spells you cast')

  OptionCheckBox
    id: showOtherSpellEffects
    !text: tr("Show other players' spell effects")
    !tooltip: tr('Draw the effects of the spells other players cast')

  Label
    id: ownSpellEffectsTransparencyLabel
    margin-top: 6
    @onSetup: |
      local value = modules.client_options.getOption('ownSpellEffectsTransparency')
      self:setText(tr('My spell effects transparency: %d%%', value))

  OptionScrollbar
    id: ownSpellEffectsTransparency
    margin-top: 3
    minimum: 0
    maximum: 90
    !tooltip: tr('Arrow keys change it once the bar is clicked')

  Label
    id: otherSpellEffectsTransparencyLabel
    margin-top: 6
    @onSetup: |
      local value = modules.client_options.getOption('otherSpellEffectsTransparency')
      self:setText(tr("Other players' spell effects transparency: %d%%", value))

  OptionScrollbar
    id: otherSpellEffectsTransparency
    margin-top: 3
    minimum: 0
    maximum: 90
    !tooltip: tr('Arrow keys change it once the bar is clicked')

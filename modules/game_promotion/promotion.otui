// The sacred fountain's window, on the Task Board's and Store's pieces (data/images/taskboard, data/images/store).
// Inside the window: 628 x 448. A header of 64 (caption, what to do, the level), then the stone stage with the two paths as
// cards of 300 x 362, 8 apart: ribbon (orange = offensive, silver = defensive), the path's outfit walking on stone, its
// benefits with an icon each, and the button. Choosing asks again in a dark layer over the whole window.

PromotionFrame < UIWidget
  image-source: /images/taskboard/frame
  image-border: 3
  phantom: true

PromotionBox < UIWidget
  image-source: /images/taskboard/inset
  image-border: 2
  phantom: true

PromotionGoldButton < UIButton
  font: verdana-11px-rounded
  color: #ffeab0
  image-source: /images/store/gold_button
  image-clip: 0 0 40 30
  image-border: 4
  text-offset: 0 0
  change-cursor-image: true
  cursor: pointer

  $hover !disabled:
    image-clip: 0 30 40 30
    color: #ffffff

  $pressed:
    image-clip: 0 60 40 30
    text-offset: 1 1

  $disabled:
    image-color: #ffffff70
    color: #ffeab060
    change-cursor-image: false

PromotionBenefit < UIWidget
  height: 20
  phantom: true

  UIWidget
    id: icon
    size: 16 16
    anchors.left: parent.left
    anchors.verticalCenter: parent.verticalCenter
    image-smooth: true
    phantom: true

  Label
    id: text
    anchors.left: icon.right
    anchors.right: parent.right
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 8
    height: 14
    font: verdana-11px-rounded
    color: #d8d8d8
    phantom: true

PromotionCard < PromotionFrame
  size: 300 362
  phantom: false

  UIWidget
    id: ribbon
    size: 244 38
    anchors.top: parent.top
    anchors.horizontalCenter: parent.horizontalCenter
    margin-top: 6
    image-source: /images/taskboard/ribbon
    phantom: true

    Label
      id: name
      anchors.top: parent.top
      anchors.left: parent.left
      anchors.right: parent.right
      margin: 11 22 0 44
      height: 14
      text-align: center
      font: verdana-11px-rounded
      color: #ffffff
      phantom: true

  Label
    id: kind
    anchors.top: ribbon.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 1
    height: 14
    text-align: center
    font: verdana-11px-rounded
    color: #e8964a
    phantom: true

  PromotionBox
    id: portrait
    size: 124 124
    anchors.top: kind.bottom
    anchors.horizontalCenter: parent.horizontalCenter
    margin-top: 4

    UIWidget
      id: floor
      anchors.fill: parent
      margin: 2
      image-source: /images/taskboard/stage
      image-clip: 274 91 120 120
      phantom: true

    UICreature
      id: creature
      size: 112 112
      anchors.centerIn: parent
      phantom: true

  UIWidget
    id: line
    size: 150 14
    anchors.top: portrait.bottom
    anchors.horizontalCenter: parent.horizontalCenter
    margin-top: 4
    image-source: /images/taskboard/divider
    phantom: true

  PromotionGoldButton
    id: chooseButton
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    margin: 0 16 10 16
    height: 30

  Panel
    id: benefits
    anchors.top: line.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.bottom: chooseButton.top
    margin: 4 18 6 18
    phantom: true
    layout:
      type: verticalBox
      spacing: 0

  Label
    id: status
    anchors.horizontalCenter: chooseButton.horizontalCenter
    anchors.verticalCenter: chooseButton.verticalCenter
    text-auto-resize: true
    font: verdana-11px-rounded
    color: #f4d68c
    phantom: true
    visible: false

  UIWidget
    id: seal
    size: 18 18
    anchors.right: status.left
    anchors.verticalCenter: status.verticalCenter
    margin-right: 6
    image-source: /images/taskboard/seal18
    phantom: true
    visible: false

MainWindow
  id: promotionWindow
  !text: tr('The Sacred Fountain')
  size: 660 530
  visible: false
  @onEscape: modules.game_promotion.onEscape()

  // ------------------------------------------------------------------------------------------- what to do, and the level
  PromotionFrame
    id: header
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: parent.right
    height: 64

    Label
      id: caption
      anchors.top: parent.top
      anchors.left: parent.left
      anchors.right: parent.right
      margin: 2 2 0 2
      height: 18
      image-source: /images/taskboard/caption
      image-border: 2
      text-align: center
      color: #d8c08a
      font: verdana-11px-rounded
      phantom: true

  Label
    id: intro
    anchors.top: header.top
    anchors.left: header.left
    anchors.right: header.right
    margin: 24 8 0 8
    height: 14
    text-align: center
    font: verdana-11px-rounded
    color: #c4c4c4
    phantom: true

  Label
    id: requirement
    anchors.top: intro.bottom
    anchors.left: header.left
    anchors.right: header.right
    margin: 4 8 0 8
    height: 14
    text-align: center
    font: verdana-11px-rounded
    color: #8fd48f
    phantom: true

  // closes the window (Escape and walking away close it too)
  Button
    id: closeButton
    !text: tr('Close')
    width: 70
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    @onClick: modules.game_promotion.hide()

  // ------------------------------------------------------------------------------------------- the two paths on stone
  UIWidget
    id: stage
    anchors.top: header.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.bottom: closeButton.top
    margin-top: 6
    margin-bottom: 6
    image-source: /images/taskboard/stage
    phantom: true

  PromotionCard
    id: card1
    anchors.top: stage.top
    anchors.left: stage.left
    margin: 8 0 0 10

  PromotionCard
    id: card2
    anchors.top: stage.top
    anchors.right: stage.right
    margin: 8 10 0 0

  // ------------------------------------------------------------------------------------------- is this your final choice?
  UIWidget
    id: confirm
    anchors.fill: parent
    background-color: #000000d0
    visible: false
    focusable: true

    PromotionFrame
      id: box
      size: 460 214
      anchors.centerIn: parent

      Label
        id: caption
        anchors.top: parent.top
        anchors.left: parent.left
        anchors.right: parent.right
        margin: 2 2 0 2
        height: 18
        image-source: /images/taskboard/caption
        image-border: 2
        text-align: center
        color: #d8c08a
        font: verdana-11px-rounded
        phantom: true

      UIWidget
        id: ribbon
        size: 244 38
        anchors.top: caption.bottom
        anchors.horizontalCenter: parent.horizontalCenter
        margin-top: 8
        image-source: /images/taskboard/ribbon_gold
        phantom: true

        Label
          id: name
          anchors.top: parent.top
          anchors.left: parent.left
          anchors.right: parent.right
          margin: 11 22 0 44
          height: 14
          text-align: center
          font: verdana-11px-rounded
          color: #ffffff
          phantom: true

      Label
        id: question
        anchors.top: ribbon.bottom
        anchors.left: parent.left
        anchors.right: parent.right
        margin: 10 16 0 16
        height: 20
        text-align: center
        font: sans-bold-16px
        color: #f4d68c
        phantom: true

      Label
        id: warning
        anchors.top: question.bottom
        anchors.left: parent.left
        anchors.right: parent.right
        margin: 8 24 0 24
        height: 32
        text-align: center
        text-wrap: true
        font: verdana-11px-rounded
        color: #d0d0d0
        phantom: true

      PromotionGoldButton
        id: acceptButton
        !text: tr('ACCEPT MY FATE')
        size: 170 30
        anchors.bottom: parent.bottom
        anchors.right: parent.horizontalCenter
        margin: 0 6 14 0

      Button
        id: cancelButton
        !text: tr('CANCEL')
        size: 130 30
        anchors.bottom: parent.bottom
        anchors.left: parent.horizontalCenter
        margin: 0 0 14 6

HealthManaCircles < UIWidget
  anchors.fill: parent
  phantom: true
  focusable: false

// one layer of a circle: circles.lua gives each its picture
CircleLayer < UIWidget
  anchors.fill: parent
  phantom: true
  focusable: false

HealthManaCircle < UIWidget
  phantom: true
  focusable: false

  CircleLayer
    id: back

  CircleLayer
    id: fill

  CircleLayer
    id: frame

  // the number in the medallion: the margins put its middle there
  Label
    id: percent
    anchors.horizontalCenter: parent.left
    anchors.verticalCenter: parent.top
    font: verdana-9px-bold
    color: #f0e2b6
    text-auto-resize: true
    phantom: true

  // only while the controls are open
  UIWidget
    id: outline
    anchors.fill: parent
    visible: false
    phantom: true
    focusable: false
    border-width: 1
    border-color: #f4d68c

CircleTab < Button
  height: 21
  $on:
    image-clip: 0 46 22 23
    color: #f4d68c

CircleRowName < Label
  height: 15
  color: #dfdfdf

CircleRowValue < Label
  height: 15
  width: 44
  text-align: right
  color: #f4d68c

CircleEditor < Window
  id: circleEditor
  size: 252 262
  focusable: false
  !text: tr('Health and mana circles')

  CircleTab
    id: healthTab
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: parent.horizontalCenter
    margin-right: 2
    !text: tr('Health')

  CircleTab
    id: manaTab
    anchors.top: parent.top
    anchors.left: parent.horizontalCenter
    anchors.right: parent.right
    margin-left: 2
    !text: tr('Mana')

  CircleRowName
    id: sizeName
    anchors.top: healthTab.bottom
    anchors.left: parent.left
    margin-top: 9
    width: 120
    !text: tr('Size')

  CircleRowValue
    id: sizeValue
    anchors.top: sizeName.top
    anchors.right: parent.right

  HorizontalScrollBar
    id: sizeBar
    anchors.top: sizeName.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 2
    step: 5

  CircleRowName
    id: opacityName
    anchors.top: sizeBar.bottom
    anchors.left: parent.left
    margin-top: 8
    width: 120
    !text: tr('Opacity')

  CircleRowValue
    id: opacityValue
    anchors.top: opacityName.top
    anchors.right: parent.right

  HorizontalScrollBar
    id: opacityBar
    anchors.top: opacityName.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 2
    step: 5

  CheckBox
    id: together
    anchors.top: opacityBar.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 10
    !text: tr('Same size and opacity for both')

  CheckBox
    id: showPercent
    anchors.top: together.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 5
    !text: tr('Show the percentage')

  Label
    id: hint
    anchors.top: showPercent.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 8
    height: 42
    text-wrap: true
    color: #a8a8a8
    !text: tr('Drag a circle to move it, with Shift to move both. Wheel over a circle: size. Ctrl and wheel: opacity.')

  Button
    id: reset
    anchors.bottom: parent.bottom
    anchors.left: parent.left
    width: 72
    !text: tr('Reset')

  Button
    id: close
    anchors.bottom: parent.bottom
    anchors.right: parent.right
    width: 72
    !text: tr('Close')

RulesWindow < MainWindow
  id: rulesWindow
  !text: tr('ForgottenL - Rules and Terms')
  size: 640 520
  @onEscape: modules.game_rules.hide()

  TabBar
    id: tabBar
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: parent.right

  MultilineTextEdit
    id: text
    anchors.top: textScroll.top
    anchors.left: parent.left
    anchors.right: textScroll.left
    anchors.bottom: textScroll.bottom
    vertical-scrollbar: textScroll
    text-wrap: true
    editable: false
    color: #e8e0c8

  VerticalScrollBar
    id: textScroll
    anchors.top: tabBar.bottom
    anchors.bottom: footer.top
    anchors.right: parent.right
    margin-top: 8
    margin-bottom: 8
    step: 16
    pixels-scroll: true

  Label
    id: footer
    anchors.left: parent.left
    anchors.right: closeButton.left
    anchors.bottom: parent.bottom
    margin-right: 10
    text-wrap: true
    text-auto-resize: true
    color: #e0b44c
    !text: tr('By playing ForgottenL you accept these rules and terms. Say !rules to read them again.')

  Button
    id: closeButton
    !text: tr('Close')
    anchors.bottom: parent.bottom
    anchors.right: parent.right
    width: 70
    @onClick: modules.game_rules.hide()

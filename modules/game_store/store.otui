// The Store, in the style of the Task Board: the stone of the retro layout, with pictures in data/images/store and
// data/images/taskboard (tools/make_store_art.py, tools/make_task_art.py).
// The window is a grid of 748 x 474 inside: header 52, gap 4, columns 386 (160 + 4 + 368 + 4 + 212), gap 6, last row 26.
// A frame's caption ends 20 pixels down. Inside the columns everything stays 6 pixels from the edges and from each other,
// which gives the offers two columns of 168 and four whole rows of 84.

StoreFrame < UIWidget
  image-source: /images/taskboard/frame
  image-border: 3
  phantom: true

StoreCaptionFrame < StoreFrame
  Label
    id: caption
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: parent.right
    margin: 2 2 0 2
    height: 18
    image-source: /images/taskboard/caption
    image-border: 2
    text-align: center
    color: #d8c08a
    font: verdana-11px-rounded
    phantom: true

StoreBox < UIWidget
  image-source: /images/taskboard/inset
  image-border: 2
  phantom: true

StorePlate < UIWidget
  image-source: /images/taskboard/plate
  image-border: 2
  phantom: true

StoreGoldButton < UIButton
  font: verdana-11px-rounded
  color: #ffeab0
  image-source: /images/store/gold_button
  image-clip: 0 0 40 30
  image-border: 4
  text-offset: 0 0
  change-cursor-image: true
  cursor: pointer

  $hover !disabled:
    image-clip: 0 30 40 30
    color: #ffffff

  $pressed:
    image-clip: 0 60 40 30
    text-offset: 1 1

  $disabled:
    image-color: #ffffff70
    color: #ffeab060
    change-cursor-image: false

StoreCategory < UIButton
  height: 30
  focusable: true
  image-source: /images/store/tab
  image-clip: 0 0 48 34
  image-border: 4
  font: verdana-11px-rounded
  text-align: left
  text-offset: 36 0
  color: #a8a8a8

  $hover !focus:
    image-clip: 0 34 48 34
    color: #dcdcdc

  $focus:
    image-clip: 0 68 48 34
    color: #f4d68c

  UIWidget
    id: picture
    size: 26 26
    anchors.left: parent.left
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 5
    phantom: true

StoreOffer < UIWidget
  size: 168 84
  focusable: true
  image-source: /images/store/offer
  image-border: 2

  $hover !focus:
    image-source: /images/store/offer_hover

  $focus:
    image-source: /images/store/offer_focus

  Label
    id: name
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: parent.right
    margin: 2 2 0 2
    height: 16
    image-source: /images/taskboard/caption
    image-border: 2
    text-align: center
    font: verdana-11px-rounded
    color: #ececec
    phantom: true

  StoreBox
    id: itemBox
    size: 52 52
    anchors.left: parent.left
    anchors.top: name.bottom
    margin-left: 6
    margin-top: 7

    UIItem
      id: item
      size: 32 32
      anchors.centerIn: parent
      virtual: true
      phantom: true

    UICreature
      id: creature
      size: 48 48
      anchors.centerIn: parent
      phantom: true
      visible: false

  StorePlate
    id: priceBox
    height: 24
    anchors.left: itemBox.right
    anchors.right: parent.right
    anchors.verticalCenter: itemBox.verticalCenter
    margin-left: 6
    margin-right: 6

    UIWidget
      id: coin
      size: 14 14
      anchors.right: parent.right
      anchors.verticalCenter: parent.verticalCenter
      margin-right: 5
      image-source: /images/store/coin14
      phantom: true

    Label
      id: price
      anchors.left: parent.left
      anchors.right: coin.left
      anchors.verticalCenter: parent.verticalCenter
      margin-left: 2
      margin-right: 2
      text-align: center
      font: verdana-11px-rounded
      color: #f4d68c
      phantom: true

StoreStaffButton < Button
  height: 22

MainWindow
  id: storeWindow
  !text: tr('Store')
  size: 780 515
  visible: false

  StoreFrame
    id: pointsBox
    height: 52
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.top: parent.top

    UIWidget
      id: coins
      size: 36 36
      anchors.left: parent.left
      anchors.verticalCenter: parent.verticalCenter
      margin-left: 8
      image-source: /images/store/coins36
      phantom: true

    Label
      id: pointsCaption
      !text: tr('Your points')
      anchors.left: coins.right
      anchors.bottom: parent.verticalCenter
      margin-left: 8
      margin-bottom: 1
      text-auto-resize: true
      color: #c8c8c8
      phantom: true

    Label
      id: pointsLabel
      text: ...
      anchors.left: pointsCaption.left
      anchors.top: parent.verticalCenter
      margin-top: 1
      text-auto-resize: true
      font: verdana-11px-rounded
      color: #f4d68c
      phantom: true

    UIWidget
      id: ribbon
      size: 244 38
      anchors.centerIn: parent
      image-source: /images/taskboard/ribbon_gold
      phantom: true

      UIWidget
        id: title
        size: 124 16
        anchors.top: parent.top
        anchors.horizontalCenter: parent.horizontalCenter
        margin-top: 11
        margin-left: 22
        image-source: /images/store/title
        phantom: true

    StoreGoldButton
      id: buyPointsButton
      !text: tr('Buy Points')
      size: 136 36
      anchors.right: parent.right
      anchors.verticalCenter: parent.verticalCenter
      margin-right: 8
      text-offset: 15 0
      @onClick: modules.game_store.openBuyPoints()

      UIWidget
        size: 26 26
        anchors.left: parent.left
        anchors.verticalCenter: parent.verticalCenter
        margin-left: 6
        image-source: /images/store/purse26
        phantom: true

  StoreCaptionFrame
    id: categoriesBox
    width: 160
    anchors.left: parent.left
    anchors.top: pointsBox.bottom
    anchors.bottom: bottomBar.top
    margin-top: 4
    margin-bottom: 6

    ScrollablePanel
      id: categories
      anchors.top: caption.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.bottom: parent.bottom
      margin: 6 6 6 6
      vertical-scrollbar: categoriesScroll
      layout:
        type: verticalBox
        spacing: 2

    // only with more categories than the column holds
    VerticalScrollBar
      id: categoriesScroll
      anchors.top: caption.bottom
      anchors.bottom: parent.bottom
      anchors.right: parent.right
      margin: 1 3 3 0
      step: 32
      pixels-scroll: true
      visible: false

  StoreCaptionFrame
    id: details
    width: 212
    anchors.right: parent.right
    anchors.top: categoriesBox.top
    anchors.bottom: categoriesBox.bottom

    StoreBox
      id: bigBox
      size: 84 84
      anchors.horizontalCenter: parent.horizontalCenter
      anchors.top: caption.bottom
      margin-top: 8

      UIItem
        id: bigItem
        size: 64 64
        anchors.centerIn: parent
        virtual: true

      UICreature
        id: bigCreature
        size: 80 80
        anchors.centerIn: parent
        phantom: true
        visible: false

    UIWidget
      size: 18 18
      anchors.left: parent.left
      anchors.top: caption.bottom
      margin: 1 0 0 2
      image-source: /images/taskboard/corner_tl
      phantom: true

    UIWidget
      size: 18 18
      anchors.right: parent.right
      anchors.top: caption.bottom
      margin: 1 2 0 0
      image-source: /images/taskboard/corner_tr
      phantom: true

    Label
      id: offerName
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.top: bigBox.bottom
      margin: 6 8 0 8
      text-align: center
      color: #ffffff
      text-wrap: true
      text-auto-resize: true
      font: verdana-11px-rounded

    StorePlate
      id: priceBox
      size: 120 24
      anchors.horizontalCenter: parent.horizontalCenter
      anchors.top: offerName.bottom
      margin-top: 6

      UIWidget
        id: coin
        size: 14 14
        anchors.right: parent.right
        anchors.verticalCenter: parent.verticalCenter
        margin-right: 5
        image-source: /images/store/coin14
        phantom: true

      Label
        id: offerPrice
        anchors.left: parent.left
        anchors.right: coin.left
        anchors.verticalCenter: parent.verticalCenter
        margin-left: 2
        margin-right: 2
        text-align: center
        font: verdana-11px-rounded
        color: #f4d68c

    UIWidget
      id: line
      size: 150 14
      anchors.top: priceBox.bottom
      anchors.horizontalCenter: parent.horizontalCenter
      margin-top: 4
      image-source: /images/taskboard/divider
      phantom: true

    StoreBox
      id: descBox
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.top: line.bottom
      anchors.bottom: charLabel.top
      margin: 4 8 6 8
      padding: 6

      Label
        id: offerDesc
        anchors.fill: parent
        text-wrap: true
        text-align: topLeft
        color: #cfcfcf

    Label
      id: charLabel
      !text: tr('Deliver to')
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.bottom: charBox.top
      margin-bottom: 2
      height: 14
      text-align: center
      color: #c8c8c8

    ComboBox
      id: charBox
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.bottom: buyButton.top
      margin: 0 8 6 8

    StoreGoldButton
      id: buyButton
      !text: tr('Buy')
      height: 30
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.bottom: parent.bottom
      margin: 0 8 8 8
      @onClick: modules.game_store.buy()

  StoreCaptionFrame
    id: offersBox
    anchors.left: categoriesBox.right
    anchors.right: details.left
    anchors.top: categoriesBox.top
    anchors.bottom: categoriesBox.bottom
    margin-left: 4
    margin-right: 4

    ScrollablePanel
      id: offers
      anchors.top: caption.bottom
      anchors.left: parent.left
      anchors.right: offersScroll.left
      anchors.bottom: parent.bottom
      margin: 6 4 6 6
      vertical-scrollbar: offersScroll
      layout:
        type: grid
        cell-size: 168 84
        cell-spacing: 6
        flow: true

    VerticalScrollBar
      id: offersScroll
      anchors.top: caption.bottom
      anchors.bottom: parent.bottom
      anchors.right: parent.right
      margin: 1 3 3 0
      step: 45
      pixels-scroll: true

    Label
      id: noOffers
      !text: tr('Nothing here yet.')
      anchors.centerIn: parent
      text-auto-resize: true
      font: verdana-11px-rounded
      color: #c8c8c8
      visible: false

  Panel
    id: bottomBar
    height: 26
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.bottom: parent.bottom

    // only for the staff
    StoreFrame
      id: staffFrame
      height: 58
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.top: parent.top
      visible: false

      Panel
        id: adminBar
        height: 22
        anchors.left: parent.left
        anchors.right: parent.right
        anchors.top: parent.top
        margin: 6 8 0 8

        Label
          !text: tr('Offers')
          anchors.left: parent.left
          anchors.verticalCenter: parent.verticalCenter
          width: 52
          font: verdana-11px-rounded
          color: #d8c08a

        StoreStaffButton
          id: addBtn
          !text: tr('Add item')
          width: 76
          anchors.left: parent.left
          anchors.verticalCenter: parent.verticalCenter
          margin-left: 52
          @onClick: modules.game_store.adminEdit(false)

        StoreStaffButton
          id: editBtn
          !text: tr('Edit')
          width: 76
          anchors.left: prev.right
          anchors.verticalCenter: parent.verticalCenter
          margin-left: 4
          @onClick: modules.game_store.adminEdit(true)

        StoreStaffButton
          id: removeBtn
          !text: tr('Remove')
          width: 76
          anchors.left: prev.right
          anchors.verticalCenter: parent.verticalCenter
          margin-left: 4
          @onClick: modules.game_store.adminRemove()

        StoreStaffButton
          id: addCatBtn
          !text: tr('Add category')
          width: 118
          anchors.left: prev.right
          anchors.verticalCenter: parent.verticalCenter
          margin-left: 16
          @onClick: modules.game_store.adminCategory(false)

        StoreStaffButton
          id: renameCatBtn
          !text: tr('Rename category')
          width: 118
          anchors.left: prev.right
          anchors.verticalCenter: parent.verticalCenter
          margin-left: 4
          @onClick: modules.game_store.adminCategory(true)

        StoreStaffButton
          id: delCatBtn
          !text: tr('Remove category')
          width: 118
          anchors.left: prev.right
          anchors.verticalCenter: parent.verticalCenter
          margin-left: 4
          @onClick: modules.game_store.adminRemoveCategory()

      Panel
        id: pointsBar
        height: 22
        anchors.left: parent.left
        anchors.right: parent.right
        anchors.top: adminBar.bottom
        margin: 4 8 0 8

        Label
          !text: tr('Points')
          anchors.left: parent.left
          anchors.verticalCenter: parent.verticalCenter
          width: 52
          font: verdana-11px-rounded
          color: #d8c08a

        StoreStaffButton
          !text: tr('Add')
          width: 76
          anchors.left: parent.left
          anchors.verticalCenter: parent.verticalCenter
          margin-left: 52
          @onClick: modules.game_store.adminPoints('add')

        StoreStaffButton
          !text: tr('Edit')
          width: 76
          anchors.left: prev.right
          anchors.verticalCenter: parent.verticalCenter
          margin-left: 4
          @onClick: modules.game_store.adminPoints('set')

        StoreStaffButton
          !text: tr('Remove')
          width: 76
          anchors.left: prev.right
          anchors.verticalCenter: parent.verticalCenter
          margin-left: 4
          @onClick: modules.game_store.adminPoints('remove')

    Button
      id: closeButton
      !text: tr('Close')
      width: 90
      height: 26
      anchors.right: parent.right
      anchors.bottom: parent.bottom
      @onClick: modules.game_store.hide()

    Label
      id: statusLabel
      anchors.left: parent.left
      anchors.right: closeButton.left
      anchors.verticalCenter: closeButton.verticalCenter
      margin-left: 2
      margin-right: 8
      color: #c8c8c8

  @onEscape: modules.game_store.hide()

StoreEditWindow < MainWindow
  size: 360 400
  !text: tr('Store offer')

  Label
    !text: tr('Name')
    anchors.left: parent.left
    anchors.top: parent.top
  TextEdit
    id: name
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.top: prev.bottom
    margin-top: 2

  Label
    !text: tr('Category')
    anchors.left: parent.left
    anchors.top: prev.bottom
    margin-top: 8
  ComboBox
    id: category
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.top: prev.bottom
    margin-top: 2

  Label
    !text: tr('Description')
    anchors.left: parent.left
    anchors.top: prev.bottom
    margin-top: 8
  TextEdit
    id: description
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.top: prev.bottom
    margin-top: 2
    height: 60
    multiline: true

  Label
    id: priceLabel
    !text: tr('Price (points)')
    anchors.left: parent.left
    anchors.top: description.bottom
    margin-top: 8
  Label
    id: itemLabel
    !text: tr('Item id (server)')
    anchors.left: parent.horizontalCenter
    anchors.top: priceLabel.top
    margin-left: 4
  TextEdit
    id: price
    anchors.left: parent.left
    anchors.right: parent.horizontalCenter
    anchors.top: priceLabel.bottom
    margin-top: 2
    margin-right: 4
  TextEdit
    id: item
    anchors.left: parent.horizontalCenter
    anchors.right: parent.right
    anchors.top: itemLabel.bottom
    margin-top: 2
    margin-left: 4

  Label
    id: countLabel
    !text: tr('Count per unit')
    anchors.left: parent.left
    anchors.top: price.bottom
    margin-top: 8
  Label
    id: amountLabel
    !text: tr('Amount')
    anchors.left: parent.horizontalCenter
    anchors.top: countLabel.top
    margin-left: 4
  TextEdit
    id: count
    anchors.left: parent.left
    anchors.right: parent.horizontalCenter
    anchors.top: countLabel.bottom
    margin-top: 2
    margin-right: 4
  TextEdit
    id: amount
    anchors.left: parent.horizontalCenter
    anchors.right: parent.right
    anchors.top: amountLabel.bottom
    margin-top: 2
    margin-left: 4

  Button
    id: okButton
    !text: tr('Save')
    width: 80
    anchors.right: cancelButton.left
    anchors.bottom: parent.bottom
    margin-right: 6

  Button
    id: cancelButton
    !text: tr('Cancel')
    width: 80
    anchors.right: parent.right
    anchors.bottom: parent.bottom

StoreNameWindow < MainWindow
  size: 300 130
  !text: tr('Category')

  TextEdit
    id: name
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.top: parent.top

  Button
    id: okButton
    !text: tr('Save')
    width: 80
    anchors.right: cancelButton.left
    anchors.bottom: parent.bottom
    margin-right: 6

  Button
    id: cancelButton
    !text: tr('Cancel')
    width: 80
    anchors.right: parent.right
    anchors.bottom: parent.bottom

StorePointsWindow < MainWindow
  size: 320 190
  !text: tr('Donation points')

  Label
    !text: tr('Character name')
    anchors.left: parent.left
    anchors.top: parent.top
  TextEdit
    id: character
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.top: prev.bottom
    margin-top: 2

  Label
    id: amountLabel
    !text: tr('Points')
    anchors.left: parent.left
    anchors.top: prev.bottom
    margin-top: 8
  TextEdit
    id: amount
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.top: prev.bottom
    margin-top: 2

  Button
    id: okButton
    !text: tr('Apply')
    width: 80
    anchors.right: cancelButton.left
    anchors.bottom: parent.bottom
    margin-right: 6

  Button
    id: cancelButton
    !text: tr('Cancel')
    width: 80
    anchors.right: parent.right
    anchors.bottom: parent.bottom

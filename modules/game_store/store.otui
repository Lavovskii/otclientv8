// The Store, in the style of the Task Board: the stone of the retro layout, with pictures in data/images/store and
// data/images/taskboard (tools/make_store_art.py, tools/make_task_art.py).

StoreFrame < UIWidget
  image-source: /images/taskboard/frame
  image-border: 3
  phantom: true

StoreCaptionFrame < StoreFrame
  Label
    id: caption
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: parent.right
    margin: 2 2 0 2
    height: 18
    image-source: /images/taskboard/caption
    image-border: 2
    text-align: center
    color: #d8c08a
    font: verdana-11px-rounded
    phantom: true

StoreBox < UIWidget
  image-source: /images/taskboard/inset
  image-border: 2
  phantom: true

StorePlate < UIWidget
  image-source: /images/taskboard/plate
  image-border: 2
  phantom: true

StoreGoldButton < UIButton
  font: verdana-11px-rounded
  color: #ffeab0
  image-source: /images/store/gold_button
  image-clip: 0 0 40 30
  image-border: 4
  text-offset: 0 0
  change-cursor-image: true
  cursor: pointer

  $hover !disabled:
    image-clip: 0 30 40 30
    color: #ffffff

  $pressed:
    image-clip: 0 60 40 30
    text-offset: 1 1

  $disabled:
    image-color: #ffffff70
    color: #ffeab060
    change-cursor-image: false

StoreCategory < UIButton
  height: 34
  margin-bottom: 3
  focusable: true
  image-source: /images/store/tab
  image-clip: 0 0 48 34
  image-border: 4
  font: verdana-11px-rounded
  text-align: left
  text-offset: 38 0
  color: #a8a8a8

  $hover !focus:
    image-clip: 0 34 48 34
    color: #dcdcdc

  $focus:
    image-clip: 0 68 48 34
    color: #f4d68c

  UIWidget
    id: picture
    size: 26 26
    anchors.left: parent.left
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 7
    phantom: true

StoreOffer < UIWidget
  size: 168 84
  focusable: true
  image-source: /images/store/offer
  image-border: 2

  $hover !focus:
    image-source: /images/store/offer_hover

  $focus:
    image-source: /images/store/offer_focus

  Label
    id: name
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: parent.right
    margin: 2 2 0 2
    height: 17
    image-source: /images/taskboard/caption
    image-border: 2
    text-align: center
    font: verdana-11px-rounded
    color: #ececec
    phantom: true

  StoreBox
    id: itemBox
    size: 52 52
    anchors.left: parent.left
    anchors.top: name.bottom
    margin-left: 6
    margin-top: 5

    UIItem
      id: item
      size: 32 32
      anchors.centerIn: parent
      virtual: true
      phantom: true

  Label
    id: amount
    anchors.left: itemBox.right
    anchors.right: parent.right
    anchors.top: itemBox.top
    margin-left: 6
    margin-right: 6
    margin-top: 6
    text-align: center
    font: verdana-11px-rounded
    color: #c8c8c8
    phantom: true

  StorePlate
    id: priceBox
    height: 22
    anchors.left: itemBox.right
    anchors.right: parent.right
    anchors.bottom: itemBox.bottom
    margin-left: 6
    margin-right: 6

    UIWidget
      id: coin
      size: 14 14
      anchors.right: parent.right
      anchors.verticalCenter: parent.verticalCenter
      margin-right: 4
      image-source: /images/store/coin14
      phantom: true

    Label
      id: price
      anchors.left: parent.left
      anchors.right: coin.left
      anchors.verticalCenter: parent.verticalCenter
      margin-left: 2
      margin-right: 2
      text-align: center
      font: verdana-11px-rounded
      color: #f4d68c
      phantom: true

MainWindow
  id: storeWindow
  !text: tr('Store')
  size: 780 505
  visible: false

  StoreFrame
    id: pointsBox
    height: 52
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.top: parent.top

    UIWidget
      id: coins
      size: 36 36
      anchors.left: parent.left
      anchors.verticalCenter: parent.verticalCenter
      margin-left: 9
      image-source: /images/store/coins36
      phantom: true

    Label
      id: pointsCaption
      !text: tr('Your points')
      anchors.left: coins.right
      anchors.top: coins.top
      margin-left: 8
      margin-top: 2
      text-auto-resize: true
      color: #c8c8c8
      phantom: true

    Label
      id: pointsLabel
      text: ...
      anchors.left: pointsCaption.left
      anchors.top: pointsCaption.bottom
      margin-top: 2
      text-auto-resize: true
      font: verdana-11px-rounded
      color: #f4d68c
      phantom: true

    UIWidget
      id: ribbon
      size: 244 38
      anchors.centerIn: parent
      image-source: /images/taskboard/ribbon_gold
      phantom: true

      Label
        id: title
        !text: tr('ForgottenL Store')
        anchors.top: parent.top
        anchors.left: parent.left
        anchors.right: parent.right
        margin: 10 22 0 44
        height: 16
        text-align: center
        font: verdana-11px-rounded
        color: #3c2608
        phantom: true

    StoreGoldButton
      id: buyPointsButton
      !text: tr('Buy Points')
      size: 142 34
      anchors.right: parent.right
      anchors.verticalCenter: parent.verticalCenter
      margin-right: 9
      text-offset: 14 0
      @onClick: modules.game_store.openBuyPoints()

      UIWidget
        size: 26 26
        anchors.left: parent.left
        anchors.verticalCenter: parent.verticalCenter
        margin-left: 7
        image-source: /images/store/purse26
        phantom: true

  StoreCaptionFrame
    id: categoriesBox
    width: 158
    anchors.left: parent.left
    anchors.top: pointsBox.bottom
    anchors.bottom: bottomBar.top
    margin-top: 4
    margin-bottom: 5

    Panel
      id: categories
      anchors.fill: parent
      margin: 23 5 4 5
      layout:
        type: verticalBox

  StoreCaptionFrame
    id: details
    width: 216
    anchors.right: parent.right
    anchors.top: categoriesBox.top
    anchors.bottom: categoriesBox.bottom

    StoreBox
      id: bigBox
      size: 84 84
      anchors.horizontalCenter: parent.horizontalCenter
      anchors.top: caption.bottom
      margin-top: 6

      UIItem
        id: bigItem
        size: 64 64
        anchors.centerIn: parent
        virtual: true

    UIWidget
      size: 18 18
      anchors.left: parent.left
      anchors.top: caption.bottom
      margin: 1 0 0 2
      image-source: /images/taskboard/corner_tl
      phantom: true

    UIWidget
      size: 18 18
      anchors.right: parent.right
      anchors.top: caption.bottom
      margin: 1 2 0 0
      image-source: /images/taskboard/corner_tr
      phantom: true

    Label
      id: offerName
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.top: bigBox.bottom
      margin: 6 8 0 8
      text-align: center
      color: #ffffff
      text-wrap: true
      text-auto-resize: true
      font: verdana-11px-rounded

    StorePlate
      id: priceBox
      height: 24
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.top: offerName.bottom
      margin: 5 30 0 30

      UIWidget
        id: coin
        size: 14 14
        anchors.right: parent.right
        anchors.verticalCenter: parent.verticalCenter
        margin-right: 6
        image-source: /images/store/coin14
        phantom: true

      Label
        id: offerPrice
        anchors.left: parent.left
        anchors.right: coin.left
        anchors.verticalCenter: parent.verticalCenter
        text-align: center
        font: verdana-11px-rounded
        color: #f4d68c

    UIWidget
      id: line
      size: 150 14
      anchors.top: priceBox.bottom
      anchors.horizontalCenter: parent.horizontalCenter
      margin-top: 3
      image-source: /images/taskboard/divider
      phantom: true

    StoreBox
      id: descBox
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.top: line.bottom
      anchors.bottom: charLabel.top
      margin: 3 8 4 8
      padding: 5

      Label
        id: offerDesc
        anchors.fill: parent
        text-wrap: true
        text-align: topLeft
        color: #cfcfcf

    Label
      id: charLabel
      !text: tr('Deliver to')
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.bottom: charBox.top
      margin-bottom: 2
      text-align: center
      color: #c8c8c8

    ComboBox
      id: charBox
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.bottom: buyButton.top
      margin: 0 8 5 8

    StoreGoldButton
      id: buyButton
      !text: tr('Buy')
      height: 32
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.bottom: parent.bottom
      margin: 0 8 6 8
      @onClick: modules.game_store.buy()

  StoreCaptionFrame
    id: offersBox
    anchors.left: categoriesBox.right
    anchors.right: details.left
    anchors.top: categoriesBox.top
    anchors.bottom: categoriesBox.bottom
    margin-left: 4
    margin-right: 4

    ScrollablePanel
      id: offers
      anchors.top: caption.bottom
      anchors.left: parent.left
      anchors.right: offersScroll.left
      anchors.bottom: parent.bottom
      margin: 4 3 4 5
      vertical-scrollbar: offersScroll
      layout:
        type: grid
        cell-size: 168 84
        cell-spacing: 3
        flow: true

    VerticalScrollBar
      id: offersScroll
      anchors.top: caption.bottom
      anchors.bottom: parent.bottom
      anchors.right: parent.right
      margin: 1 3 3 0
      step: 30
      pixels-scroll: true

    Label
      id: noOffers
      !text: tr('Nothing here yet.')
      anchors.centerIn: parent
      text-auto-resize: true
      font: verdana-11px-rounded
      color: #c8c8c8
      visible: false

  Panel
    id: bottomBar
    height: 28
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.bottom: parent.bottom

    Panel
      id: adminBar
      height: 26
      visible: false
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.top: parent.top

      Label
        !text: tr('Admin')
        color: #ff9a4a
        anchors.left: parent.left
        anchors.verticalCenter: parent.verticalCenter
        width: 44

      Button
        id: addBtn
        !text: tr('Add item')
        width: 80
        anchors.left: prev.right
        anchors.verticalCenter: parent.verticalCenter
        @onClick: modules.game_store.adminEdit(false)

      Button
        id: editBtn
        !text: tr('Edit')
        width: 60
        anchors.left: prev.right
        anchors.verticalCenter: parent.verticalCenter
        margin-left: 4
        @onClick: modules.game_store.adminEdit(true)

      Button
        id: removeBtn
        !text: tr('Remove')
        width: 70
        anchors.left: prev.right
        anchors.verticalCenter: parent.verticalCenter
        margin-left: 4
        @onClick: modules.game_store.adminRemove()

      Button
        id: addCatBtn
        !text: tr('Add category')
        width: 100
        anchors.left: prev.right
        anchors.verticalCenter: parent.verticalCenter
        margin-left: 14
        @onClick: modules.game_store.adminCategory(false)

      Button
        id: renameCatBtn
        !text: tr('Rename category')
        width: 115
        anchors.left: prev.right
        anchors.verticalCenter: parent.verticalCenter
        margin-left: 4
        @onClick: modules.game_store.adminCategory(true)

      Button
        id: delCatBtn
        !text: tr('Remove category')
        width: 115
        anchors.left: prev.right
        anchors.verticalCenter: parent.verticalCenter
        margin-left: 4
        @onClick: modules.game_store.adminRemoveCategory()

    Panel
      id: pointsBar
      height: 26
      visible: false
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.top: adminBar.bottom
      margin-top: 4

      Label
        !text: tr('Points')
        color: #ff9a4a
        anchors.left: parent.left
        anchors.verticalCenter: parent.verticalCenter
        width: 44

      Button
        !text: tr('Add points')
        width: 90
        anchors.left: prev.right
        anchors.verticalCenter: parent.verticalCenter
        @onClick: modules.game_store.adminPoints('add')

      Button
        !text: tr('Remove points')
        width: 110
        anchors.left: prev.right
        anchors.verticalCenter: parent.verticalCenter
        margin-left: 4
        @onClick: modules.game_store.adminPoints('remove')

      Button
        !text: tr('Edit points')
        width: 90
        anchors.left: prev.right
        anchors.verticalCenter: parent.verticalCenter
        margin-left: 4
        @onClick: modules.game_store.adminPoints('set')

    Label
      id: statusLabel
      anchors.left: parent.left
      anchors.right: closeButton.left
      anchors.bottom: parent.bottom
      margin-right: 8
      margin-bottom: 6
      color: #c8c8c8

    Button
      id: closeButton
      !text: tr('Close')
      width: 90
      height: 26
      anchors.right: parent.right
      anchors.bottom: parent.bottom
      @onClick: modules.game_store.hide()

  @onEscape: modules.game_store.hide()

StoreEditWindow < MainWindow
  size: 360 400
  !text: tr('Store offer')

  Label
    !text: tr('Name')
    anchors.left: parent.left
    anchors.top: parent.top
  TextEdit
    id: name
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.top: prev.bottom
    margin-top: 2

  Label
    !text: tr('Category')
    anchors.left: parent.left
    anchors.top: prev.bottom
    margin-top: 8
  ComboBox
    id: category
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.top: prev.bottom
    margin-top: 2

  Label
    !text: tr('Description')
    anchors.left: parent.left
    anchors.top: prev.bottom
    margin-top: 8
  TextEdit
    id: description
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.top: prev.bottom
    margin-top: 2
    height: 60
    multiline: true

  Label
    id: priceLabel
    !text: tr('Price (points)')
    anchors.left: parent.left
    anchors.top: description.bottom
    margin-top: 8
  Label
    id: itemLabel
    !text: tr('Item id (server)')
    anchors.left: parent.horizontalCenter
    anchors.top: priceLabel.top
    margin-left: 4
  TextEdit
    id: price
    anchors.left: parent.left
    anchors.right: parent.horizontalCenter
    anchors.top: priceLabel.bottom
    margin-top: 2
    margin-right: 4
  TextEdit
    id: item
    anchors.left: parent.horizontalCenter
    anchors.right: parent.right
    anchors.top: itemLabel.bottom
    margin-top: 2
    margin-left: 4

  Label
    id: countLabel
    !text: tr('Count per unit')
    anchors.left: parent.left
    anchors.top: price.bottom
    margin-top: 8
  Label
    id: amountLabel
    !text: tr('Amount')
    anchors.left: parent.horizontalCenter
    anchors.top: countLabel.top
    margin-left: 4
  TextEdit
    id: count
    anchors.left: parent.left
    anchors.right: parent.horizontalCenter
    anchors.top: countLabel.bottom
    margin-top: 2
    margin-right: 4
  TextEdit
    id: amount
    anchors.left: parent.horizontalCenter
    anchors.right: parent.right
    anchors.top: amountLabel.bottom
    margin-top: 2
    margin-left: 4

  Button
    id: okButton
    !text: tr('Save')
    width: 80
    anchors.right: cancelButton.left
    anchors.bottom: parent.bottom
    margin-right: 6

  Button
    id: cancelButton
    !text: tr('Cancel')
    width: 80
    anchors.right: parent.right
    anchors.bottom: parent.bottom

StoreNameWindow < MainWindow
  size: 300 130
  !text: tr('Category')

  TextEdit
    id: name
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.top: parent.top

  Button
    id: okButton
    !text: tr('Save')
    width: 80
    anchors.right: cancelButton.left
    anchors.bottom: parent.bottom
    margin-right: 6

  Button
    id: cancelButton
    !text: tr('Cancel')
    width: 80
    anchors.right: parent.right
    anchors.bottom: parent.bottom

StorePointsWindow < MainWindow
  size: 320 190
  !text: tr('Donation points')

  Label
    !text: tr('Character name')
    anchors.left: parent.left
    anchors.top: parent.top
  TextEdit
    id: character
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.top: prev.bottom
    margin-top: 2

  Label
    id: amountLabel
    !text: tr('Points')
    anchors.left: parent.left
    anchors.top: prev.bottom
    margin-top: 8
  TextEdit
    id: amount
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.top: prev.bottom
    margin-top: 2

  Button
    id: okButton
    !text: tr('Apply')
    width: 80
    anchors.right: cancelButton.left
    anchors.bottom: parent.bottom
    margin-right: 6

  Button
    id: cancelButton
    !text: tr('Cancel')
    width: 80
    anchors.right: parent.right
    anchors.bottom: parent.bottom

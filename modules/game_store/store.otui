StoreOffer < UIWidget
  height: 44
  margin-bottom: 2
  focusable: true
  background-color: #00000000
  $focus:
    background-color: #ffffff22
  $hover !focus:
    background-color: #ffffff11

  UIItem
    id: item
    size: 34 34
    anchors.left: parent.left
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 4
    virtual: true

  Label
    id: name
    anchors.left: prev.right
    anchors.top: parent.top
    anchors.right: parent.right
    margin: 5 4 0 8
    phantom: true

  Label
    id: price
    color: #e0b44c
    anchors.left: prev.left
    anchors.bottom: parent.bottom
    margin-bottom: 5
    phantom: true

StoreCategory < UIButton
  height: 22
  margin-bottom: 2
  text-align: left
  text-offset: 8 0
  focusable: true
  background-color: #00000000
  color: #c0c0c0
  $focus:
    background-color: #ffffff22
    color: #ffffff
  $hover !focus:
    background-color: #ffffff11

MainWindow
  id: storeWindow
  !text: tr('Store')
  size: 700 460
  visible: false

  Label
    id: pointsLabel
    text: Points: ...
    color: #e0b44c
    anchors.left: parent.left
    anchors.top: parent.top
    text-auto-resize: true

  Button
    id: buyPointsButton
    !text: tr('Buy Points')
    width: 110
    anchors.right: parent.right
    anchors.top: parent.top
    margin-top: -4
    @onClick: modules.game_store.openBuyPoints()

  Panel
    id: categories
    width: 130
    anchors.left: parent.left
    anchors.top: pointsLabel.bottom
    anchors.bottom: bottomBar.top
    margin-top: 8
    margin-bottom: 8
    layout:
      type: verticalBox

  VerticalScrollBar
    id: offersScroll
    anchors.top: categories.top
    anchors.bottom: categories.bottom
    anchors.left: offers.right
    step: 24
    pixels-scroll: true

  ScrollablePanel
    id: offers
    width: 280
    anchors.left: categories.right
    anchors.top: categories.top
    anchors.bottom: categories.bottom
    margin-left: 8
    vertical-scrollbar: offersScroll
    layout:
      type: verticalBox

  Panel
    id: details
    anchors.left: offersScroll.right
    anchors.right: parent.right
    anchors.top: categories.top
    anchors.bottom: categories.bottom
    margin-left: 8

    UIItem
      id: bigItem
      size: 64 64
      anchors.horizontalCenter: parent.horizontalCenter
      anchors.top: parent.top
      margin-top: 4
      virtual: true

    Label
      id: offerName
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.top: bigItem.bottom
      margin-top: 8
      text-align: center
      color: #ffffff
      text-wrap: true
      text-auto-resize: true

    Label
      id: offerPrice
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.top: offerName.bottom
      margin-top: 4
      text-align: center
      color: #e0b44c

    Label
      id: offerDesc
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.top: offerPrice.bottom
      margin-top: 10
      text-wrap: true
      text-auto-resize: true
      color: #c8c8c8

    Label
      id: charLabel
      !text: tr('Deliver to')
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.bottom: charBox.top
      margin-bottom: 3
      text-align: center

    ComboBox
      id: charBox
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.bottom: buyButton.top
      margin-bottom: 8

    Button
      id: buyButton
      !text: tr('Buy')
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.bottom: parent.bottom
      @onClick: modules.game_store.buy()

  Panel
    id: adminBar
    height: 24
    visible: false
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.bottom: bottomBar.top
    margin-bottom: 4

    Label
      !text: tr('Admin')
      color: #ff9a4a
      anchors.left: parent.left
      anchors.verticalCenter: parent.verticalCenter
      width: 44

    Button
      id: addBtn
      !text: tr('Add item')
      width: 80
      anchors.left: prev.right
      anchors.verticalCenter: parent.verticalCenter
      @onClick: modules.game_store.adminEdit(false)

    Button
      id: editBtn
      !text: tr('Edit')
      width: 60
      anchors.left: prev.right
      anchors.verticalCenter: parent.verticalCenter
      margin-left: 4
      @onClick: modules.game_store.adminEdit(true)

    Button
      id: removeBtn
      !text: tr('Remove')
      width: 70
      anchors.left: prev.right
      anchors.verticalCenter: parent.verticalCenter
      margin-left: 4
      @onClick: modules.game_store.adminRemove()

    Button
      id: addCatBtn
      !text: tr('Add category')
      width: 100
      anchors.left: prev.right
      anchors.verticalCenter: parent.verticalCenter
      margin-left: 12
      @onClick: modules.game_store.adminCategory(false)

    Button
      id: renameCatBtn
      !text: tr('Rename category')
      width: 110
      anchors.left: prev.right
      anchors.verticalCenter: parent.verticalCenter
      margin-left: 4
      @onClick: modules.game_store.adminCategory(true)

    Button
      id: delCatBtn
      !text: tr('Remove category')
      width: 115
      anchors.left: prev.right
      anchors.verticalCenter: parent.verticalCenter
      margin-left: 4
      @onClick: modules.game_store.adminRemoveCategory()

  Panel
    id: bottomBar
    height: 26
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.bottom: parent.bottom

    Label
      id: statusLabel
      anchors.left: parent.left
      anchors.right: closeButton.left
      anchors.verticalCenter: parent.verticalCenter
      margin-right: 8
      color: #c8c8c8

    Button
      id: closeButton
      !text: tr('Close')
      width: 80
      anchors.right: parent.right
      anchors.verticalCenter: parent.verticalCenter
      @onClick: modules.game_store.hide()

  @onEscape: modules.game_store.hide()

StoreEditWindow < MainWindow
  size: 360 380
  !text: tr('Store offer')

  Label
    !text: tr('Name')
    anchors.left: parent.left
    anchors.top: parent.top
  TextEdit
    id: name
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.top: prev.bottom
    margin-top: 2

  Label
    !text: tr('Category')
    anchors.left: parent.left
    anchors.top: prev.bottom
    margin-top: 8
  ComboBox
    id: category
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.top: prev.bottom
    margin-top: 2

  Label
    !text: tr('Description')
    anchors.left: parent.left
    anchors.top: prev.bottom
    margin-top: 8
  TextEdit
    id: description
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.top: prev.bottom
    margin-top: 2
    height: 60
    multiline: true

  Label
    !text: tr('Price (points)')
    anchors.left: parent.left
    anchors.top: prev.bottom
    margin-top: 8
  TextEdit
    id: price
    anchors.left: parent.left
    anchors.right: parent.horizontalCenter
    anchors.top: prev.bottom
    margin-top: 2
    margin-right: 4

  Label
    !text: tr('Item id')
    anchors.left: parent.horizontalCenter
    anchors.top: prev.top
    margin-left: 4
  TextEdit
    id: item
    anchors.left: parent.horizontalCenter
    anchors.right: parent.right
    anchors.top: price.top
    margin-left: 4

  Label
    !text: tr('Count (items per unit)')
    anchors.left: parent.left
    anchors.top: price.bottom
    margin-top: 8
  TextEdit
    id: count
    anchors.left: parent.left
    anchors.right: parent.horizontalCenter
    anchors.top: prev.bottom
    margin-top: 2
    margin-right: 4

  Label
    !text: tr('Amount')
    anchors.left: parent.horizontalCenter
    anchors.top: prev.top
    margin-left: 4
  TextEdit
    id: amount
    anchors.left: parent.horizontalCenter
    anchors.right: parent.right
    anchors.top: count.top
    margin-left: 4

  Button
    id: okButton
    !text: tr('Save')
    width: 80
    anchors.right: cancelButton.left
    anchors.bottom: parent.bottom
    margin-right: 6

  Button
    id: cancelButton
    !text: tr('Cancel')
    width: 80
    anchors.right: parent.right
    anchors.bottom: parent.bottom

StoreNameWindow < MainWindow
  size: 300 130
  !text: tr('Category')

  TextEdit
    id: name
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.top: parent.top

  Button
    id: okButton
    !text: tr('Save')
    width: 80
    anchors.right: cancelButton.left
    anchors.bottom: parent.bottom
    margin-right: 6

  Button
    id: cancelButton
    !text: tr('Cancel')
    width: 80
    anchors.right: parent.right
    anchors.bottom: parent.bottom

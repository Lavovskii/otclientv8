// the launcher (updater.lua): the ForgottenL login skin (client_entergame/forgottenl_style), one button in the middle;
// the ForgottenL logo above it is the login's (client_entergame/forgottenl_logo)
ForgottenLWindow
  id: updaterWindow
  size: 360 320
  // the top edge where the login window's is, under the logo
  margin-top: 6

  ForgottenLTitle
    id: version
    anchors.top: parent.top
    anchors.horizontalCenter: parent.horizontalCenter
    margin-top: 4

  ForgottenLLabel
    id: status
    anchors.top: prev.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 16
    height: 46
    text-align: center
    text-wrap: true
    !text: tr('Checking for updates...')

  ProgressBar
    id: mainProgress
    anchors.top: prev.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 6
    height: 15
    background-color: #c9962e
    visible: false

  Label
    id: downloadStatus
    anchors.top: prev.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 6
    height: 28
    color: #d8b36a
    text-align: center
    text-wrap: true
    visible: false

  ProgressBar
    id: downloadProgress
    anchors.top: prev.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 4
    height: 15
    background-color: #c9962e
    visible: false

  ForgottenLButton
    id: downloadButton
    !text: tr('Download the installer')
    anchors.horizontalCenter: parent.horizontalCenter
    anchors.bottom: playButton.top
    margin-bottom: 10
    visible: false
    @onClick: Updater.download()

  ForgottenLButton
    id: retryButton
    !text: tr('Try again')
    anchors.horizontalCenter: parent.horizontalCenter
    anchors.bottom: playButton.top
    margin-bottom: 10
    visible: false
    @onClick: Updater.check()

  ForgottenLButton
    id: playButton
    !text: tr('Play')
    anchors.horizontalCenter: parent.horizontalCenter
    anchors.bottom: parent.bottom
    margin-bottom: 30
    visible: false
    @onClick: Updater.play()

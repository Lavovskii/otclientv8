// The ForgottenL General Store: the look of the Store (pictures in data/images/store and data/images/taskboard).
// Top: BUY | SELL, the player's gold (carried + bank) and Buffary Coins, the VIP note. Left: the categories, the same in both
// tabs. Middle: the items of the category. Right: the item chosen, the amount and the button.

GsFrame < UIWidget
  image-source: /images/taskboard/frame
  image-border: 3
  phantom: true

GsCaptionFrame < GsFrame
  Label
    id: caption
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: parent.right
    margin: 2 2 0 2
    height: 18
    image-source: /images/taskboard/caption
    image-border: 2
    text-align: center
    color: #d8c08a
    font: verdana-11px-rounded
    phantom: true

GsBox < UIWidget
  image-source: /images/taskboard/inset
  image-border: 2
  phantom: true

GsPlate < UIWidget
  image-source: /images/taskboard/plate
  image-border: 2
  phantom: true

GsGoldButton < UIButton
  font: verdana-11px-rounded
  color: #ffeab0
  image-source: /images/store/gold_button
  image-clip: 0 0 40 30
  image-border: 4
  change-cursor-image: true
  cursor: pointer

  $hover !disabled:
    image-clip: 0 30 40 30
    color: #ffffff

  $pressed:
    image-clip: 0 60 40 30
    text-offset: 1 1

  $on:
    image-clip: 0 60 40 30
    color: #ffffff

  $disabled:
    image-color: #ffffff70
    color: #ffeab060
    change-cursor-image: false

// BUY and SELL: the tab shown is bright, the other one dim
GsTab < UIButton
  font: verdana-11px-rounded
  color: #8a7a58
  image-source: /images/store/gold_button
  image-clip: 0 60 40 30
  image-border: 4
  image-color: #ffffff90
  change-cursor-image: true
  cursor: pointer

  $hover !on:
    image-color: #ffffffd0
    color: #d8c08a

  $on:
    image-clip: 0 30 40 30
    image-color: #ffffff
    color: #ffffff

GsCategory < UIButton
  height: 30
  focusable: true
  image-source: /images/store/tab
  image-clip: 0 0 48 34
  image-border: 4
  font: verdana-11px-rounded
  text-align: left
  text-offset: 36 0
  color: #a8a8a8

  $hover !focus:
    image-clip: 0 34 48 34
    color: #dcdcdc

  $focus:
    image-clip: 0 68 48 34
    color: #f4d68c

  UIItem
    id: picture
    size: 26 26
    anchors.left: parent.left
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 5
    virtual: true
    phantom: true

GsOffer < UIWidget
  size: 150 80
  focusable: true
  image-source: /images/store/offer
  image-border: 2

  $hover !focus:
    image-source: /images/store/offer_hover

  $focus:
    image-source: /images/store/offer_focus

  Label
    id: name
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: parent.right
    margin: 2 2 0 2
    height: 16
    image-source: /images/taskboard/caption
    image-border: 2
    text-align: center
    font: verdana-11px-rounded
    color: #ececec
    phantom: true

  GsBox
    id: itemBox
    size: 44 44
    anchors.left: parent.left
    anchors.top: name.bottom
    margin-left: 6
    margin-top: 8

    UIItem
      id: item
      size: 32 32
      anchors.centerIn: parent
      virtual: true
      phantom: true

  GsPlate
    id: priceBox
    height: 22
    anchors.left: itemBox.right
    anchors.right: parent.right
    anchors.top: itemBox.top
    margin-left: 6
    margin-right: 6

    UIItem
      id: coin
      size: 26 26
      anchors.right: parent.right
      anchors.verticalCenter: parent.verticalCenter
      margin-right: 2
      virtual: true
      phantom: true

    Label
      id: price
      anchors.left: parent.left
      anchors.right: coin.left
      anchors.verticalCenter: parent.verticalCenter
      margin-left: 2
      text-align: center
      font: verdana-11px-rounded
      color: #f4d68c
      phantom: true

  Label
    id: note
    anchors.left: itemBox.right
    anchors.right: parent.right
    anchors.top: priceBox.bottom
    margin: 2 6 0 6
    height: 14
    text-align: center
    color: #a8d890
    phantom: true

MainWindow
  id: generalStoreWindow
  !text: tr('ForgottenL General Store')
  size: 790 520
  visible: false
  @onEscape: modules.game_generalstore.hide()

  GsFrame
    id: header
    height: 52
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.top: parent.top

    GsTab
      id: buyTab
      !text: tr('BUY')
      size: 90 32
      anchors.left: parent.left
      anchors.verticalCenter: parent.verticalCenter
      margin-left: 10
      @onClick: modules.game_generalstore.setTab('buy')

    GsTab
      id: sellTab
      !text: tr('SELL')
      size: 90 32
      anchors.left: buyTab.right
      anchors.verticalCenter: parent.verticalCenter
      margin-left: 6
      @onClick: modules.game_generalstore.setTab('sell')

    Label
      id: vipNote
      anchors.left: sellTab.right
      anchors.right: funds.left
      anchors.verticalCenter: parent.verticalCenter
      margin: 0 10 0 14
      text-wrap: true
      text-auto-resize: true
      font: verdana-11px-rounded
      color: #a8a8a8

    GsPlate
      id: funds
      size: 250 40
      anchors.right: parent.right
      anchors.verticalCenter: parent.verticalCenter
      margin-right: 8

      UIItem
        id: goldIcon
        size: 32 32
        anchors.left: parent.left
        anchors.verticalCenter: parent.verticalCenter
        margin-left: 4
        virtual: true
        phantom: true

      Label
        id: gold
        anchors.left: goldIcon.right
        anchors.verticalCenter: parent.verticalCenter
        margin-left: 2
        width: 100
        font: verdana-11px-rounded
        color: #f4d68c

      UIItem
        id: buffaryIcon
        size: 32 32
        anchors.left: gold.right
        anchors.verticalCenter: parent.verticalCenter
        virtual: true
        phantom: true

      Label
        id: buffary
        anchors.left: buffaryIcon.right
        anchors.right: parent.right
        anchors.verticalCenter: parent.verticalCenter
        margin-left: 2
        font: verdana-11px-rounded
        color: #f0a050

  GsCaptionFrame
    id: categoriesBox
    width: 160
    anchors.left: parent.left
    anchors.top: header.bottom
    anchors.bottom: statusLabel.top
    margin-top: 4
    margin-bottom: 6

    ScrollablePanel
      id: categories
      anchors.top: caption.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.bottom: parent.bottom
      margin: 6 6 6 6
      layout:
        type: verticalBox
        spacing: 2

  GsCaptionFrame
    id: details
    width: 212
    anchors.right: parent.right
    anchors.top: categoriesBox.top
    anchors.bottom: categoriesBox.bottom

    GsBox
      id: bigBox
      size: 84 84
      anchors.horizontalCenter: parent.horizontalCenter
      anchors.top: caption.bottom
      margin-top: 10

      UIItem
        id: bigItem
        size: 64 64
        anchors.centerIn: parent
        virtual: true

    Label
      id: itemName
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.top: bigBox.bottom
      margin: 6 8 0 8
      text-align: center
      color: #ffffff
      text-wrap: true
      text-auto-resize: true
      font: verdana-11px-rounded

    Label
      id: eachLabel
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.top: itemName.bottom
      margin: 6 8 0 8
      text-align: center
      color: #f4d68c
      text-wrap: true
      text-auto-resize: true

    Label
      id: haveLabel
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.top: eachLabel.bottom
      margin: 4 8 0 8
      text-align: center
      color: #c8c8c8

    UIWidget
      id: line
      size: 150 14
      anchors.top: haveLabel.bottom
      anchors.horizontalCenter: parent.horizontalCenter
      margin-top: 6
      image-source: /images/taskboard/divider
      phantom: true

    Label
      id: amountCaption
      !text: tr('Amount')
      anchors.top: line.bottom
      anchors.horizontalCenter: parent.horizontalCenter
      margin-top: 6
      text-auto-resize: true
      color: #c8c8c8

    Button
      id: minus
      text: -
      size: 24 22
      anchors.left: parent.left
      anchors.top: amountCaption.bottom
      margin: 4 0 0 20
      @onClick: modules.game_generalstore.changeAmount(-1)

    TextEdit
      id: amount
      height: 22
      anchors.left: minus.right
      anchors.right: plus.left
      anchors.top: minus.top
      margin: 0 4 0 4
      text: 1
      text-align: center

    Button
      id: plus
      text: +
      size: 24 22
      anchors.right: max.left
      anchors.top: minus.top
      margin-right: 4
      @onClick: modules.game_generalstore.changeAmount(1)

    Button
      id: max
      !text: tr('Max')
      size: 40 22
      anchors.right: parent.right
      anchors.top: minus.top
      margin-right: 16
      @onClick: modules.game_generalstore.maxAmount()

    Label
      id: totalLabel
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.top: minus.bottom
      margin: 8 8 0 8
      text-align: center
      color: #ffffff
      font: verdana-11px-rounded
      text-wrap: true
      text-auto-resize: true

    GsGoldButton
      id: actionButton
      !text: tr('Buy')
      height: 32
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.bottom: parent.bottom
      margin: 0 10 10 10
      @onClick: modules.game_generalstore.doAction()

  GsCaptionFrame
    id: itemsBox
    anchors.left: categoriesBox.right
    anchors.right: details.left
    anchors.top: categoriesBox.top
    anchors.bottom: categoriesBox.bottom
    margin-left: 4
    margin-right: 4

    ScrollablePanel
      id: items
      anchors.top: caption.bottom
      anchors.left: parent.left
      anchors.right: itemsScroll.left
      anchors.bottom: parent.bottom
      margin: 6 2 6 6
      vertical-scrollbar: itemsScroll
      layout:
        type: grid
        cell-size: 150 80
        cell-spacing: 4
        flow: true

    VerticalScrollBar
      id: itemsScroll
      anchors.top: caption.bottom
      anchors.bottom: parent.bottom
      anchors.right: parent.right
      margin: 1 3 3 0
      step: 42
      pixels-scroll: true

    Label
      id: empty
      anchors.centerIn: items
      text-auto-resize: true
      color: #a8a8a8
      visible: false

  Label
    id: statusLabel
    anchors.left: parent.left
    anchors.right: closeButton.left
    anchors.bottom: parent.bottom
    margin-right: 8
    height: 20
    text-align: left
    color: #c8c8c8

  Button
    id: closeButton
    !text: tr('Close')
    width: 80
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    @onClick: modules.game_generalstore.hide()

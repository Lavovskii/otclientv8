  GuideWin
    id: n1
    anchors.left: tomorrow.left
    anchors.top: tomorrow.bottom
    margin-top: 3
    text: Skills
  GuideWin
    id: n2
    anchors.left: n1.left
    anchors.top: n1.bottom
    margin-top: 2
    text: Backpack
  GuideWin
    id: n3
    anchors.left: n1.left
    anchors.top: n2.bottom
    margin-top: 2
    text: Battle

// a health or mana bar with its numbers
GuideBar < Label
  size: 140 15
  text-align: center
  font: verdana-11px-rounded
  color: #ffffff
  border-width: 1
  border-color: #000000
  phantom: true

// the middle of the circles around the character, at their real size (the images are cut to the medallions), and the
// bars with the real numbers
GuideCircle < UIWidget
  size: 84 84
  image-clip: 0 64 84 84
  phantom: true

ArtStats < Panel
  anchors.fill: parent

  GuideCircle
    id: hBack
    anchors.left: parent.left
    anchors.top: parent.top
    image-source: /images/game/circle/left_back
  GuideCircle
    anchors.left: hBack.left
    anchors.top: hBack.top
    image-source: /images/game/circle/left_fill
    image-color: #00bc00
  GuideCircle
    id: hFrame
    anchors.left: hBack.left
    anchors.top: hBack.top
    image-source: /images/game/circle/left_frame
  Label
    anchors.horizontalCenter: hFrame.left
    anchors.verticalCenter: hFrame.top
    margin-left: 29
    margin-top: 42
    font: verdana-9px-bold
    color: #f0e2b6
    text: 100%
    text-auto-resize: true
    phantom: true

  GuideCircle
    id: mBack
    anchors.left: hBack.right
    anchors.top: parent.top
    margin-left: 2
    image-source: /images/game/circle/right_back
  // mana at 40%: the fill starts below the medallion
  UIWidget
    size: 84 22
    anchors.left: mBack.left
    anchors.top: mBack.top
    margin-top: 62
    image-source: /images/game/circle/right_fill
    image-clip: 0 126 84 22
    image-color: #3a7bff
    phantom: true
  GuideCircle
    id: mFrame
    anchors.left: mBack.left
    anchors.top: mBack.top
    image-source: /images/game/circle/right_frame
  Label
    anchors.horizontalCenter: mFrame.right
    anchors.verticalCenter: mFrame.top
    margin-right: 29
    margin-top: 42
    font: verdana-9px-bold
    color: #f0e2b6
    text: 40%
    text-auto-resize: true
    phantom: true

  GuideBar
    id: hp
    width: 110
    anchors.left: mBack.right
    anchors.top: parent.top
    margin-left: 6
    margin-top: 10
    background-color: #b01c1c
    text: 92,130 / 92,130
  GuideBar
    id: mp
    width: 110
    anchors.left: hp.left
    anchors.top: hp.bottom
    margin-top: 4
    background-color: #1c3cb0
    text: 12,072 / 30,180
  GuideNote
    anchors.left: hp.left
    anchors.top: mp.bottom
    margin-top: 6
    text: Cap: 14k  (14,000)

// the Spells button and the window it opens: the spells of your vocation by level, with tabs
ArtSpells < Panel
  anchors.fill: parent

  UIWidget
    id: button
    size: 20 20
    anchors.left: parent.left
    anchors.top: parent.top
    margin-top: 30

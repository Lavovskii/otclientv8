  GuideSlotOn
    id: a4
    anchors.left: prev.right
    anchors.top: prev.top
    margin-left: 2
    GuideSlotText
      !text: 'Stop\nAttack'
  GuideSlotOn
    id: a5
    anchors.left: prev.right
    anchors.top: prev.top
    margin-left: 2
    GuideSlotText
      !text: 'Use\nUnder'

  GuideNote
    anchors.left: a1.left
    anchors.top: a1.bottom
    margin-top: 8
    text: They are on your left bar

ArtHotkey < Panel
  anchors.fill: parent

  GuideSlotOn
    id: before
    anchors.left: parent.left
    anchors.top: parent.top
    margin-top: 16
    GuideSlotText
      text: Loot

  GuideArrow
    id: arrow1
    anchors.left: before.right
    anchors.verticalCenter: before.verticalCenter
    margin-left: 6

  GuideKey
    id: key
    anchors.left: arrow1.right
    anchors.verticalCenter: before.verticalCenter
    margin-left: 6
    text: Space

  GuideArrow
    id: arrow2
    anchors.left: key.right
    anchors.verticalCenter: before.verticalCenter
    margin-left: 6

  GuideSlotOn
    anchors.left: arrow2.right
    anchors.verticalCenter: before.verticalCenter

    anchors.right: parent.right
    anchors.top: parent.top
    margin-top: 9

    Label
      id: deliver
      height: 14
      anchors.left: character.left
      anchors.right: character.right
      anchors.bottom: character.top
      margin-bottom: 2
      text-align: center
      color: #c8c8c8
      text: Deliver to
      phantom: true

    ComboBox
      id: character
      width: 124
      anchors.left: parent.left
      anchors.top: parent.top
      margin-left: 8
      margin-top: 30
      text: Dev
      phantom: true

    GuideArrow
      id: arrow
      anchors.left: character.right
      anchors.verticalCenter: parent.verticalCenter
      margin-left: 8

    GuideStoreBox
      id: bag
      anchors.left: arrow.right
      anchors.verticalCenter: parent.verticalCenter
      margin-left: 8

      GuideItem
        anchors.centerIn: parent
        &itemId: 2854

    GuideStoreBox
      anchors.left: bag.right
      anchors.verticalCenter: parent.verticalCenter
      margin-left: 6

      GuideItem
        anchors.centerIn: parent
        &itemId: 3160

// --- window -----------------------------------------------------------------------------------------------------------

GuideCard < Panel
  height: 96
  padding: 6
  background-color: #00000040
  border-width: 1
  border-color: #4a4032

  Panel
    id: art
    anchors.left: parent.left
    anchors.top: parent.top
    anchors.bottom: parent.bottom
    width: 290
    phantom: true

  Label
    id: title
    anchors.left: art.right
    anchors.top: parent.top
    anchors.right: parent.right
    margin-left: 10
    font: verdana-11px-rounded
    color: #ffd57a
    phantom: true

  Label
    id: text
    anchors.left: title.left
    anchors.top: title.bottom
    anchors.right: parent.right
    margin-top: 6
    text-wrap: true
    text-auto-resize: true
    font: verdana-11px-antialised
    color: #dcdcdc
    phantom: true

GuidePage < Panel
  ScrollablePanel
    id: cards
    anchors.fill: parent
    margin-right: 14
    vertical-scrollbar: scroll
    layout:
      type: verticalBox
      spacing: 6

  VerticalScrollBar
    id: scroll
    anchors.top: parent.top
    anchors.bottom: parent.bottom
    anchors.right: parent.right
    step: 60
    pixels-scroll: true

MainWindow
  id: guidesWindow
  !text: tr('Guides')
  size: 680 540
  @onEscape: modules.game_guides.hide()

  TabBar
    id: guidesTabBar
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: parent.right

  Panel
    id: guidesTabContent
    anchors.top: guidesTabBar.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.bottom: closeButton.top
    margin-top: 8
    margin-bottom: 8

  Button
    id: closeButton
    !text: tr('Close')
    width: 64
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    @onClick: modules.game_guides.hide()

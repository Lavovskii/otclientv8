ArtIgnore < Panel
  anchors.fill: parent

  GuideSlot
    id: item
    anchors.left: parent.left
    anchors.top: parent.top
    margin-top: 10
    image-source: /images/ui/item
    image-clip: 0 0 34 34
    GuideItem

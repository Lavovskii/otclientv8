    margin-left: 12
    margin-top: 12
    &itemId: 3269

  GuideMouse
    id: mouse
    anchors.left: i3.right
    anchors.top: i3.top
    margin-left: -6
    margin-top: 6

  GuideArrow
    id: arrow
    anchors.left: mouse.right
    anchors.top: parent.top
    margin-left: 6
    margin-top: 22

  UIWidget
    id: window
    anchors.left: arrow.right
    anchors.top: parent.top
    margin-left: 6
    margin-top: 4
    size: 112 78
    image-source: /images/ui/menubox
    image-border: 3
    phantom: true

    Label
      id: title
      anchors.left: parent.left
      anchors.top: parent.top
      margin: 3 0 0 5
      text-auto-resize: true
      font: verdana-11px-antialised
      color: #dfdfdf
      text: Browse Field
      phantom: true

    GuideSlot
      id: b1
      anchors.left: parent.left
      anchors.top: title.bottom
      margin: 3 0 0 3
      image-source: /images/ui/item
      image-clip: 0 0 34 34
      GuideItem
        anchors.centerIn: parent
        &itemId: 3357
    GuideSlot
      id: b2
      anchors.left: prev.right
      anchors.top: prev.top
      margin-left: 2
      image-source: /images/ui/item
      image-clip: 0 0 34 34

  GuideArrow
    id: arrow2
    anchors.left: key.right
    anchors.verticalCenter: key.verticalCenter
    margin-left: 6

  GuideSlot
    id: bag
    anchors.left: arrow2.right
    anchors.verticalCenter: key.verticalCenter
    margin-left: 6
    image-source: /images/ui/item
    image-clip: 0 0 34 34
    GuideItem
      anchors.centerIn: parent
      &itemId: 3031
      &itemCount: 100

  GuideSlot
    anchors.left: bag.right
    anchors.verticalCenter: key.verticalCenter
    margin-left: 2
    image-source: /images/ui/item
    image-clip: 0 0 34 34
    GuideItem
      anchors.centerIn: parent
      &itemId: 3583

ArtLootBag < Panel
  anchors.fill: parent

  GuideSlot
    id: bag
    anchors.left: parent.left
    anchors.top: parent.top

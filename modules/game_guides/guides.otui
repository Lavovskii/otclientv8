  GuideMouse
    id: mouse
    anchors.left: item.right
    anchors.top: item.top
    margin-left: -10
    margin-top: 18

  GuideArrow
    id: arrow
    anchors.left: mouse.right
    anchors.top: item.top
    margin-left: 6
    margin-top: 8

  GuideMenu
    anchors.left: arrow.right
    anchors.top: parent.top
    margin-left: 6
    width: 170
    GuideMenuLine
      text: Look
    GuideMenuLine
      text: Add to ignore loot list
      on: true

ArtLootChannel < Panel
  anchors.fill: parent

  UIWidget
    id: console
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.top: parent.top
    margin-top: 10
    height: 52
    background-color: #1c1c1c
    border-width: 1
    border-color: #5a5a5a
    phantom: true

    Label
      id: tab1
      anchors.left: parent.left
      anchors.top: parent.top
      margin: 3 0 0 4
      text-auto-resize: true
      font: verdana-11px-antialised
      color: #8a8a8a
      text: Default
      phantom: true

    Label
      id: tab2
      anchors.left: tab1.right
      anchors.top: tab1.top
      margin-left: 12
      text-auto-resize: true
      font: verdana-11px-antialised
      color: #ffffff
      text: Loot
      phantom: true

    Label
      anchors.left: parent.left
      anchors.top: tab1.bottom
      margin: 6 0 0 6
      text-auto-resize: true
      font: verdana-11px-antialised
      color: #e8e8e8
      text: Loot of a dragon: 120 gold coins, dragon ham
      phantom: true

// --- drawings: Items --------------------------------------------------------------------------------------------------

ArtBrowse < Panel
  anchors.fill: parent

  GuideItem
    id: i1
    anchors.left: parent.left
    anchors.top: parent.top
    margin-top: 12
    &itemId: 3357
  GuideItem
    id: i2
    anchors.left: i1.left
    anchors.top: i1.top
    margin-left: 6
    margin-top: 6
    &itemId: 3286
  GuideItem
    id: i3
    anchors.left: i1.left

    id: mouse
    anchors.left: bag.right
    anchors.top: bag.top
    margin-left: -10
    margin-top: 18

  GuideArrow
    id: arrow
    anchors.left: mouse.right
    anchors.top: bag.top
    margin-left: 6
    margin-top: 8

  GuideMenu

// --- drawings: Interface ----------------------------------------------------------------------------------------------

// a game window, as a small title bar
GuideWin < Label
  size: 84 18
  text-offset: 5 0
  text-align: left
  font: verdana-11px-antialised
  color: #dfdfdf
  background-color: #3a342c
  border-width: 1
  border-color: #6b5c40
  phantom: true

// the same windows today and at the next login
ArtWindows < Panel
  anchors.fill: parent

  GuideNote
    id: today

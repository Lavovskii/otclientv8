// the bottom of the console with the chat off, then what the keys do
ArtChat < Panel
  anchors.fill: parent

  UIWidget
    id: box
    size: 196 22
    anchors.left: parent.left
    anchors.top: parent.top
    image-source: /images/ui/textedit
    image-border: 1
    opacity: 0.5
    phantom: true

  Label
    anchors.fill: box
    text-offset: 6 0
    font: verdana-11px-antialised
    color: #8a8a8a
    text: Chat off: press Enter to talk
    phantom: true

  UIWidget
    id: button
    size: 64 22
    anchors.left: box.right
    anchors.top: box.top
    margin-left: 3
    image-source: /images/ui/button
    image-clip: 0 0 22 23
    image-border: 3
    image-color: #dfdfdf
    font: verdana-11px-antialised
    color: #f09a9a
    text: Chat Off
    phantom: true

  GuideKey
    id: k1
    anchors.left: parent.left
    anchors.top: box.bottom
    margin-top: 8
    text: 1
  GuideKey
    id: k2
    anchors.left: prev.right
    anchors.top: prev.top
    margin-left: 3
    text: Q
  GuideKey
    id: k3
    anchors.left: prev.right
    anchors.top: prev.top
    margin-left: 3
    text: Space
  GuideNote
    anchors.left: prev.right
    anchors.verticalCenter: prev.verticalCenter
    margin-left: 8
    text: your hotkeys

  GuideKey
    id: enter
    anchors.left: parent.left
    anchors.top: k1.bottom
    margin-top: 6
    text: Enter
  GuideNote
    anchors.left: prev.right
    anchors.verticalCenter: prev.verticalCenter
    margin-left: 8
    text: say one thing


    anchors.bottom: parent.bottom
    width: 224
    margin-left: 6
    background-color: #1c1c1c
    border-width: 1
    border-color: #5b4b25
    phantom: true

    GuideTab
      id: all
      anchors.left: parent.left
      anchors.top: parent.top
      margin-left: 4
      margin-top: 4

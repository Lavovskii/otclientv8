      phantom: true

    UIWidget
      id: icon
      size: 26 26
      anchors.left: parent.left
      anchors.top: header.bottom
      margin-left: 4
      margin-top: 4
      image-source: /images/game/spells/defaultspells
      image-clip: 224 96 32 32
      phantom: true
    Label
      id: name
      anchors.left: icon.right
      anchors.top: icon.top
      margin-left: 6
      font: verdana-11px-rounded
      color: #e6e6e6
      text: Fire Wave
      text-auto-resize: true
      phantom: true
    Label
      anchors.left: name.left
      anchors.top: name.bottom
      margin-top: 1
      font: verdana-11px-rounded
      color: #c9a95a
      text: exevo flam hur
      text-auto-resize: true
      phantom: true
    Label
      anchors.right: parent.right
      anchors.top: icon.top
      margin-right: 5
      font: verdana-11px-rounded
      color: #9f9f9f
      text: Lv 18
      text-auto-resize: true
      phantom: true


    font: verdana-11px-rounded
    color: #f0f000
    text: Dev says: hi
    phantom: true

ArtAction < Panel
  anchors.fill: parent

  GuideSlotOn
    id: a1
    anchors.left: parent.left
    anchors.top: parent.top
    margin-top: 14
    GuideSlotText
      text: Loot
  GuideSlotOn

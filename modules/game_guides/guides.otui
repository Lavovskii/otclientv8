    anchors.left: prev.right
    anchors.top: prev.top
    margin-left: 2
    GuideSlotText
      !text: 'Use\nUnder'

  GuideNote
    anchors.left: a1.left
    anchors.top: a1.bottom
    margin-top: 8
    text: They are on your left bar

ArtHotkey < Panel
  anchors.fill: parent

  GuideSlotOn
    id: before
    anchors.left: parent.left
    anchors.top: parent.top
    margin-top: 16
    GuideSlotText

// ForgottenL login-screen skin. Scoped ONLY to the entergame (account/password) window,
// so nothing in-game is affected: these are new class names (not overrides of the shared
// Window/TextEdit/Button/Label classes used everywhere else in the client).

ForgottenLWindow < StaticMainWindow
  image-source: /images/ui/forgottenl_window
  image-border: 48
  color: #e8d4a6
  text-align: top
  text-offset: 0 14
  font: verdana-11px-antialised
  padding-top: 56
  padding-left: 26
  padding-right: 26
  padding-bottom: 22

ForgottenLCrest < UIWidget
  image-source: /images/forgottenl_logo
  image-smooth: true
  size: 560 177
  phantom: true

ForgottenLTitle < UILabel
  font: verdana-11px-antialised
  color: #ffe29a
  text-align: center
  text-auto-resize: true

ForgottenLLabel < UILabel
  font: verdana-11px-antialised
  color: #d8b36a

ForgottenLTextEdit < UITextEdit
  font: verdana-11px-antialised
  color: #f0dcae
  size: 190 30
  text-offset: 0 0
  padding: 8 9 3 9
  opacity: 1
  image-source: /images/ui/forgottenl_textedit
  image-border: 5
  selection-color: #f0dcae
  selection-background-color: #e0b44c
  change-cursor-image: true

  $disabled:
    color: #2a1a0e88
    opacity: 0.6
    change-cursor-image: false

ForgottenLPasswordTextEdit < ForgottenLTextEdit
  text-hidden: true

ForgottenLButton < UIButton
  font: verdana-11px-antialised
  color: #ffe9b3
  size: 230 42
  text-offset: 0 -2
  image-source: /images/ui/forgottenl_button
  image-color: #ffffff
  opacity: 1.0
  change-cursor-image: true
  cursor: pointer

  $hover !disabled:
    image-color: #ffffff
    color: #fff6dd

  $pressed:
    image-color: #cfcfcf
    text-offset: 0 -1

  $disabled:
    image-color: #ffffff66
    color: #ffe29a66
    change-cursor-image: false

// a gold bar in a dark track with a gold edge (the launcher, Guides): the progress is the child 'fill', an image
// (UIProgressBar sizes it), and its text is the child 'caption', drawn over the fill
ForgottenLProgressBar < UIProgressBar
  height: 20
  image-source: /images/ui/forgottenl_bar
  image-border: 5
  background-color: #00000000
  background-border: 3

  UIWidget
    id: fill
    anchors.left: parent.left
    anchors.top: parent.top
    anchors.bottom: parent.bottom
    margin: 3
    image-source: /images/ui/forgottenl_bar_fill
    image-border-left: 2
    image-border-right: 2
    phantom: true

  UILabel
    id: caption
    anchors.fill: parent
    text-align: center
    font: verdana-11px-rounded
    color: #fff6dc
    phantom: true

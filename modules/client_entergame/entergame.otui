ForgottenLWindow
  id: enterGame
  size: 300 360
  @onEnter: EnterGame.doLogin()

  ForgottenLCrest
    anchors.horizontalCenter: parent.horizontalCenter
    anchors.top: parent.top
    margin-top: -58

  ForgottenLLabel
    id: accountLabel
    !text: tr('Account name')
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.top: parent.top
    margin-top: 30
    text-align: center

  ForgottenLTextEdit
    id: accountNameTextEdit
    anchors.horizontalCenter: parent.horizontalCenter
    anchors.top: accountLabel.bottom
    margin-top: 4
    width: 190

  ForgottenLLabel
    id: passwordLabel
    !text: tr('Password')
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.top: accountNameTextEdit.bottom
    margin-top: 10
    text-align: center

  ForgottenLPasswordTextEdit
    id: accountPasswordTextEdit
    anchors.horizontalCenter: parent.horizontalCenter
    anchors.top: passwordLabel.bottom
    margin-top: 4
    width: 190

  // TFS 0.4 has no 2FA/token login; the field is kept (hidden, zero-size) only
  // because entergame.lua still looks it up by id when building the login request.
  ForgottenLLabel
    id: tokenLabel
    !text: tr('Token')
    visible: false
    height: 0
    anchors.left: parent.left
    anchors.top: accountPasswordTextEdit.bottom

  ForgottenLTextEdit
    id: accountTokenTextEdit
    visible: false
    height: 0
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.top: tokenLabel.bottom

  Panel
    id: serverSelectorPanel
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.top: accountPasswordTextEdit.bottom
    height: 52
    on: true
    focusable: false

    $on:
      visible: true
      margin-top: 0

    $!on:
      visible: false
      margin-top: -52

    HorizontalSeparator
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.top: parent.top
      margin-top: 10

    ForgottenLLabel
      id: serverLabel
      !text: tr('Server')
      anchors.left: parent.left
      anchors.top: prev.bottom
      text-auto-resize: true
      margin-top: 5

    ComboBox
      id: serverSelector
      anchors.left: prev.left
      anchors.right: parent.right
      anchors.top: serverLabel.bottom
      margin-top: 2
      margin-right: 3
      menu-scroll: true
      menu-height: 125
      menu-scroll-step: 25
      text-offset: 5 2
      @onOptionChange: EnterGame.onServerChange()

  Panel
    id: customServerSelectorPanel
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.top: serverSelectorPanel.bottom
    height: 52
    on: true
    focusable: true

    $on:
      visible: true
      margin-top: 0

    $!on:
      visible: false
      margin-top: -52

    HorizontalSeparator
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.top: parent.top
      margin-top: 8

    ForgottenLLabel
      id: serverLabel
      !text: tr('IP:PORT or URL')
      anchors.left: prev.left
      anchors.top: prev.bottom
      margin-top: 8
      text-auto-resize: true

    TextEdit
      id: serverHostTextEdit
      !tooltip: tr('Make sure that your client uses\nthe correct game client version')
      anchors.left: parent.left
      anchors.top: serverLabel.bottom
      margin-top: 2
      width: 150

    ForgottenLLabel
      id: clientLabel
      !text: tr('Version')
      anchors.left: serverHostTextEdit.right
      anchors.top: serverLabel.top
      text-auto-resize: true
      margin-left: 10

    ComboBox
      id: clientVersionSelector
      anchors.top: serverHostTextEdit.top
      anchors.bottom: serverHostTextEdit.bottom
      anchors.left: prev.left
      anchors.right: parent.right
      menu-scroll: true
      menu-height: 125
      menu-scroll-step: 25
      margin-right: 3

  HorizontalSeparator
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.top: customServerSelectorPanel.bottom
    margin-top: 14

  CheckBox
    id: rememberPasswordBox
    !text: tr('Remember password')
    !tooltip: tr('Remember account and password when starts client')
    color: #d8b36a
    width: 170
    anchors.horizontalCenter: parent.horizontalCenter
    anchors.top: prev.bottom
    margin-top: 10

  ForgottenLButton
    !text: tr('Login')
    anchors.horizontalCenter: parent.horizontalCenter
    anchors.top: prev.bottom
    margin-top: 16
    width: 190
    @onClick: EnterGame.doLogin()

  Label
    id: serverInfoLabel
    font: verdana-11px-rounded
    anchors.top: prev.top
    anchors.left: parent.left
    margin-top: 5
    color: green
    text-auto-resize: true

// The Skills window, laid out like today's Tibia and split in sections: level and experience, the character, the
// skills, combat (what the equipment gives), protection and bonuses (VIP, boosters...). Every line has an icon (a
// sprite of the game) and explains itself under the mouse. The values the 8.70 protocol does not send come from the
// server through extended opcode 8 (see skills.lua).

SkillButton < UIButton
  height: 15
  margin-bottom: 1
  &onClick: onSkillButtonClick
  // the colour out of hover must be set too: leaving $hover only puts back what the style sets
  background-color: alpha

  $hover:
    background-color: #ffffff12

SkillBarButton < SkillButton
  height: 21

SkillNameLabel < GameLabel
  id: name
  font: verdana-11px-monochrome
  anchors.left: parent.left
  anchors.top: parent.top
  height: 14
  phantom: true

SkillValueLabel < GameLabel
  id: value
  font: verdana-11px-monochrome
  text-align: topright
  anchors.right: parent.right
  anchors.top: parent.top
  anchors.left: prev.right
  height: 14
  phantom: true

SkillPercentPanel < ProgressBar
  id: percent
  background-color: green
  height: 5
  margin-top: 15
  anchors.left: parent.left
  anchors.right: parent.right
  anchors.top: parent.top
  phantom: false

// a small sprite in front of the name (set from Lua: &itemId)
SkillIcon < UIItem
  id: icon
  size: 12 12
  anchors.left: parent.left
  anchors.top: parent.top
  margin-top: 1
  virtual: true
  phantom: true

SkillIconImage < UIWidget
  id: icon
  size: 12 12
  anchors.left: parent.left
  anchors.top: parent.top
  margin-top: 1
  phantom: true

// a name with its icon
SkillIconNameLabel < SkillNameLabel
  anchors.left: icon.right
  margin-left: 4

// the title of a section, with a thin golden line after it
SkillSection < UIWidget
  height: 17
  margin-top: 3
  margin-bottom: 1
  phantom: true

  Label
    id: title
    anchors.left: parent.left
    anchors.verticalCenter: parent.verticalCenter
    text-auto-resize: true
    font: verdana-11px-rounded
    color: #e8c66a
    phantom: true

  UIWidget
    anchors.left: title.right
    anchors.right: parent.right
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 5
    height: 1
    background-color: #e8c66a40
    phantom: true

// a line made from Lua (combat, protection, bonuses): icon + name + value
SkillInfoRow < SkillButton
  SkillIcon
  SkillIconNameLabel
  SkillValueLabel

SkillInfoRowImage < SkillButton
  SkillIconImage
  SkillIconNameLabel
  SkillValueLabel

SkillListPanel < Panel
  layout:
    type: verticalBox
    fit-children: true

// a fixed line with an item icon (its children are written in the window below)
SkillItemRow < SkillButton

SkillItemBarRow < SkillBarButton

MiniWindow
  id: skillWindow
  !text: tr('Skills')
  height: 150
  icon: /images/topbuttons/skills
  @onClose: modules.game_skills.onMiniWindowClose()
  &save: true
  &autoOpen: false

  MiniWindowContents
    padding-left: 5
    padding-right: 5
    layout: verticalBox

    // level and experience
    SkillBarButton
      margin-top: 4
      id: level
      SkillNameLabel
        !text: tr('Level')
      SkillValueLabel
      SkillPercentPanel
        background-color: red

    SkillButton
      id: experience
      SkillNameLabel
        !text: tr('Experience')
      SkillValueLabel

    SkillItemRow
      id: xpRate
      SkillIcon
        &itemId: 7440
      SkillIconNameLabel
        !text: tr('XP Gain Rate')
      SkillValueLabel

    SkillItemRow
      id: xpBoost
      visible: false
      SkillIcon
        &itemId: 138
      SkillIconNameLabel
        !text: tr('XP Boost')
      SkillValueLabel

    SkillSection
      id: characterSection

    SkillItemRow
      id: health
      SkillIcon
        &itemId: 266
      SkillIconNameLabel
        !text: tr('Hit Points')
      SkillValueLabel

    SkillItemRow
      id: mana
      SkillIcon
        &itemId: 268
      SkillIconNameLabel
        !text: tr('Mana')
      SkillValueLabel

    SkillItemRow
      id: soul
      SkillIcon
        &itemId: 5944
      SkillIconNameLabel
        !text: tr('Soul Points')
      SkillValueLabel

    SkillItemRow
      id: capacity
      SkillIcon
        &itemId: 2854
      SkillIconNameLabel
        !text: tr('Capacity')
      SkillValueLabel

    SkillItemRow
      id: speed
      SkillIcon
        &itemId: 3079
      SkillIconNameLabel
        !text: tr('Speed')
      SkillValueLabel

    SkillItemRow
      id: food
      SkillIcon
        &itemId: 3582
      SkillIconNameLabel
        !text: tr('Food')
      SkillValueLabel

    SkillItemBarRow
      id: stamina
      SkillIcon
        &itemId: 112
      SkillIconNameLabel
        !text: tr('Stamina')
      SkillValueLabel
      SkillPercentPanel

    SkillSection
      id: skillsSection

    SkillItemBarRow
      id: magiclevel
      SkillIcon
        &itemId: 648
      SkillIconNameLabel
        !text: tr('Magic')
      SkillValueLabel
      SkillPercentPanel
        background-color: red

    SkillBarButton
      id: skillId0
      SkillIconImage
        image-source: /images/game/skills_fist
      SkillIconNameLabel
        !text: tr('Fist')
      SkillValueLabel
      SkillPercentPanel

    SkillItemBarRow
      id: skillId1
      SkillIcon
        &itemId: 3286
      SkillIconNameLabel
        !text: tr('Club')
      SkillValueLabel
      SkillPercentPanel

    SkillItemBarRow
      id: skillId2
      SkillIcon
        &itemId: 3264
      SkillIconNameLabel
        !text: tr('Sword')
      SkillValueLabel
      SkillPercentPanel

    SkillItemBarRow
      id: skillId3
      SkillIcon
        &itemId: 3274
      SkillIconNameLabel
        !text: tr('Axe')
      SkillValueLabel
      SkillPercentPanel

    SkillItemBarRow
      id: skillId4
      SkillIcon
        &itemId: 3350
      SkillIconNameLabel
        !text: tr('Distance')
      SkillValueLabel
      SkillPercentPanel

    SkillItemBarRow
      id: skillId5
      SkillIcon
        &itemId: 3409
      SkillIconNameLabel
        !text: tr('Shielding')
      SkillValueLabel
      SkillPercentPanel

    SkillItemBarRow
      id: skillId6
      SkillIcon
        &itemId: 3483
      SkillIconNameLabel
        !text: tr('Fishing')
      SkillValueLabel
      SkillPercentPanel

    // what the equipment gives, protection and the character's bonuses (from the server)
    SkillSection
      id: combatSection

    SkillListPanel
      id: combatPanel

    SkillSection
      id: protectionSection

    SkillListPanel
      id: protectionPanel

    SkillSection
      id: bonusSection

    SkillListPanel
      id: bonusPanel

    UIWidget
      height: 4
      phantom: true

// Inspect: a player's equipment and stats, or a monster's loot (without chances). The server answers extended opcode 33.

InspectSlot < UIWidget
  size: 40 40
  image-source: /images/taskboard/inset
  image-border: 2

  UIItem
    id: item
    size: 32 32
    anchors.centerIn: parent
    virtual: true
    phantom: true

InspectStat < UIWidget
  height: 16

  Label
    id: name
    anchors.left: parent.left
    anchors.verticalCenter: parent.verticalCenter
    text-auto-resize: true
    color: #c8c8c8
    phantom: true

  Label
    id: value
    anchors.right: parent.right
    anchors.verticalCenter: parent.verticalCenter
    text-auto-resize: true
    color: #ffffff
    phantom: true

InspectLoot < UIWidget
  size: 44 44
  image-source: /images/taskboard/inset
  image-border: 2

  UIItem
    id: item
    size: 32 32
    anchors.centerIn: parent
    virtual: true
    phantom: true

// the new player page (the owner, 2026-11-09: prettier, organised, icons and tiles, no scroll)
InspectTile < UIWidget
  size: 112 38
  background-color: #0e0c0a99
  border-width: 1
  border-color: #3a3024
  phantom: false

  UIItem
    id: icon
    size: 26 26
    anchors.left: parent.left
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 5
    virtual: true
    phantom: true

  UIWidget
    id: image
    size: 22 22
    anchors.left: parent.left
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 7
    phantom: true
    visible: false

  Label
    id: value
    anchors.left: icon.right
    anchors.right: parent.right
    anchors.top: parent.top
    margin-left: 6
    margin-top: 4
    font: verdana-11px-rounded
    color: #ffffff
    phantom: true

  Label
    id: name
    anchors.left: value.left
    anchors.right: parent.right
    anchors.top: value.bottom
    margin-top: 1
    font: verdana-9px
    color: #9a9080
    phantom: true

InspectChip < UIWidget
  size: 90 22
  background-color: #0e0c0a99
  border-width: 1
  border-color: #3a3024

  UIItem
    id: icon
    size: 16 16
    anchors.left: parent.left
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 3
    virtual: true
    phantom: true

  Label
    id: value
    anchors.left: icon.right
    anchors.right: parent.right
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 4
    font: verdana-11px-rounded
    phantom: true

InspectSection < Label
  height: 16
  font: verdana-11px-rounded
  color: #f4d68c
  text-offset: 0 1

InspectGrid < UIWidget
  layout:
    type: grid
    cell-size: 112 38
    cell-spacing: 4
    flow: true
    fit-children: true

InspectChips < UIWidget
  layout:
    type: grid
    cell-size: 90 22
    cell-spacing: 4
    flow: true
    fit-children: true

InspectBar < UIWidget
  height: 16
  background-color: #1a1612
  border-width: 1
  border-color: #3a3024

  UIWidget
    id: fill
    anchors.left: parent.left
    anchors.top: parent.top
    anchors.bottom: parent.bottom
    margin: 1
    phantom: true

  Label
    id: text
    anchors.fill: parent
    text-align: center
    font: verdana-11px-rounded
    color: #ffffff
    phantom: true

MainWindow
  id: inspectWindow
  !text: tr('Inspect')
  size: 680 480
  visible: false
  @onEscape: modules.game_inspect.hide()

  UICreature
    id: outfit
    size: 48 48
    anchors.top: parent.top
    anchors.left: parent.left
    margin-left: 46
    margin-top: -6
    phantom: true

  Label
    id: title
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: parent.right
    height: 20
    text-align: center
    font: verdana-11px-rounded
    color: #f4d68c

  Label
    id: subtitle
    anchors.top: title.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    height: 14
    text-align: center
    font: verdana-11px-rounded
    color: #c8c0b0

  Panel
    id: playerPanel
    anchors.top: subtitle.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.bottom: closeButton.top
    margin-top: 10
    margin-bottom: 8

    Panel
      id: equipment
      width: 140
      height: 182
      anchors.top: parent.top
      anchors.left: parent.left

      InspectSlot
        id: slot1
        anchors.top: parent.top
        anchors.horizontalCenter: parent.horizontalCenter
      InspectSlot
        id: slot2
        anchors.top: slot1.top
        anchors.right: slot1.left
        margin-right: 4
        margin-top: 10
      InspectSlot
        id: slot3
        anchors.top: slot1.top
        anchors.left: slot1.right
        margin-left: 4
        margin-top: 10
      InspectSlot
        id: slot4
        anchors.top: slot1.bottom
        anchors.horizontalCenter: parent.horizontalCenter
        margin-top: 4
      InspectSlot
        id: slot6
        anchors.top: slot4.top
        anchors.right: slot4.left
        margin-right: 4
        margin-top: 10
      InspectSlot
        id: slot5
        anchors.top: slot4.top
        anchors.left: slot4.right
        margin-left: 4
        margin-top: 10
      InspectSlot
        id: slot7
        anchors.top: slot4.bottom
        anchors.horizontalCenter: parent.horizontalCenter
        margin-top: 4
      InspectSlot
        id: slot9
        anchors.top: slot7.top
        anchors.right: slot7.left
        margin-right: 4
        margin-top: 10
      InspectSlot
        id: slot10
        anchors.top: slot7.top
        anchors.left: slot7.right
        margin-left: 4
        margin-top: 10
      InspectSlot
        id: slot8
        anchors.top: slot7.bottom
        anchors.horizontalCenter: parent.horizontalCenter
        margin-top: 4

    InspectBar
      id: healthBar
      anchors.top: equipment.bottom
      anchors.left: equipment.left
      anchors.right: equipment.right
      margin-top: 10

    InspectBar
      id: manaBar
      anchors.top: healthBar.bottom
      anchors.left: equipment.left
      anchors.right: equipment.right
      margin-top: 4

    Panel
      id: stats
      anchors.top: parent.top
      anchors.left: equipment.right
      anchors.right: parent.right
      anchors.bottom: parent.bottom
      margin-left: 16
      layout:
        type: verticalBox
        spacing: 3

  Panel
    id: monsterPanel
    anchors.top: subtitle.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.bottom: closeButton.top
    margin-top: 6
    margin-bottom: 8
    visible: false

    Label
      id: lootCaption
      !text: tr('It may drop:')
      anchors.top: parent.top
      anchors.left: parent.left
      text-auto-resize: true
      color: #c8c8c8

    ScrollablePanel
      id: loot
      anchors.top: lootCaption.bottom
      anchors.left: parent.left
      anchors.right: lootScroll.left
      anchors.bottom: parent.bottom
      margin-top: 6
      margin-right: 4
      vertical-scrollbar: lootScroll
      layout:
        type: grid
        cell-size: 44 44
        cell-spacing: 4
        flow: true

    VerticalScrollBar
      id: lootScroll
      anchors.top: lootCaption.bottom
      anchors.bottom: parent.bottom
      anchors.right: parent.right
      step: 48
      pixels-scroll: true

  Button
    id: closeButton
    !text: tr('Close')
    width: 80
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    @onClick: modules.game_inspect.hide()

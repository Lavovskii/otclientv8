GameButtonsWindow < HeadlessMiniWindow
  height: 62
  &forceOpen: true
  &autoOpen: 4

  MiniWindowContents
    margin-top: 2

    // the website's red dragon plate with a golden neon STORE on top (the neon layer pulses, see game_store)
    Button
      id: storeWideButton
      height: 32
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.top: parent.top
      image-source: /images/ui/store_plate
      image-border: 0
      image-color: #e6e6e6
      text-offset: 0 0
      $hover:
        image-color: #ffffff
      $pressed:
        image-color: #bdbdbd
      @onClick: modules.game_store.toggle()

      UIWidget
        id: neon
        anchors.fill: parent
        phantom: true
        image-source: /images/ui/store_neon
        image-border: 0

    Panel
      id: buttons
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.top: prev.bottom
      anchors.bottom: parent.bottom
      margin-top: 4
      layout:
        type: grid
        cell-spacing: 3
        cell-size: 20 20
        flow: true
